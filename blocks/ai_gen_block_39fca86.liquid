{% doc %}
  @prompt
    On the collection page product cards, move the "Save" / discount badge so it appears in the top-left corner overlaying the product image, instead of below the price. The theme is called Impact. Use CSS to reposition the badge (likely class .product-card__badge-list or similar) so it sits at the top-left of the product image with absolute positioning. Do not affect the desktop layout if it already shows correctly there.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-badge-reposition-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  @media screen and (max-width: 999px) {
    .ai-badge-reposition-{{ ai_gen_id }} .product-card__badge-list {
      position: absolute !important;
      top: {{ block.settings.badge_top_offset }}px;
      left: {{ block.settings.badge_left_offset }}px;
      bottom: auto !important;
      right: auto !important;
      z-index: 2;
      margin: 0 !important;
    }

    .ai-badge-reposition-{{ ai_gen_id }} .product-card__figure {
      position: relative;
    }

    .ai-badge-reposition-{{ ai_gen_id }} .product-card__info {
      position: relative;
    }
  }
{% endstyle %}

<style>
  @media screen and (max-width: 999px) {
    .product-card__badge-list {
      position: absolute !important;
      top: {{ block.settings.badge_top_offset }}px;
      left: {{ block.settings.badge_left_offset }}px;
      bottom: auto !important;
      right: auto !important;
      z-index: 2;
      margin: 0 !important;
    }

    .product-card__figure {
      position: relative;
    }
  }
</style>

<div class="ai-badge-reposition-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <p style="text-align: center; color: {{ block.settings.text_color }}; font-size: 12px; padding: 8px;">
    {{ block.settings.helper_text }}
  </p>
</div>

{% schema %}
{
  "name": "Badge position fix",
  "settings": [
    {
      "type": "header",
      "content": "Badge position"
    },
    {
      "type": "paragraph",
      "content": "This block repositions the discount badge to overlay the top-left corner of product images on mobile. The CSS applies globally to all product cards on collection pages."
    },
    {
      "type": "range",
      "id": "badge_top_offset",
      "label": "Top offset",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "badge_left_offset",
      "label": "Left offset",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Helper text"
    },
    {
      "type": "inline_richtext",
      "id": "helper_text",
      "label": "Helper text",
      "default": "Badge repositioning active (mobile only)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    }
  ],
  "presets": [
    {
      "name": "Badge position fix"
    }
  ]
}
{% endschema %}
