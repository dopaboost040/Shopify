{% doc %}
  @prompt
    "Maak een 'How it works' sectie met 3 stappen (Mix, Drink, Thrive).
    
    Desktop weergave: Toon alle 3 stappen horizontaal naast elkaar in een rij. Elke stap heeft een afbeelding bovenaan en tekst eronder.
    
    Mobiele weergave: Toon de stappen verticaal onder elkaar (stapeling). Elke stap neemt de volledige breedte in. De afbeelding moet vierkant zijn (1:1 aspect ratio) en de volledige afbeelding moet zichtbaar zijn zonder bijsnijding.
    
    Styling: Gebruik voor de titel 'How it works' dezelfde elegante serif-lettertype als de andere titels op de pagina. Verwijder de nummers (1, 2, 3) onder de afbeeldingen - toon alleen de staptitel en beschrijvingstekst.
    
    Zorg ervoor dat het responsive is en goed werkt op zowel desktop als mobiel.", op de telefoon staan ze onder elkaar. dat moet een slider zijn. 
    
    De teksten onder de foto's moeten links staan in plaats in het midden, titel moet ook links komen te staan in plaats van in het midden 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-how-it-works-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-how-it-works-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-how-it-works-title-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 60px;
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-how-it-works-steps-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .ai-how-it-works-step-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .ai-how-it-works-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-how-it-works-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-how-it-works-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-how-it-works-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-how-it-works-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.step_title_color }};
    margin: 0 0 12px;
  }

  .ai-how-it-works-step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_description_size }}px;
    color: {{ block.settings.step_description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-how-it-works-slider-wrapper-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-how-it-works-{{ ai_gen_id }} {
      padding: 30px 0;
    }

    .ai-how-it-works-title-{{ ai_gen_id }} {
      text-align: left;
      margin-bottom: 40px;
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
      padding: 0 16px;
    }

    .ai-how-it-works-steps-{{ ai_gen_id }} {
      display: none;
    }

    .ai-how-it-works-slider-wrapper-{{ ai_gen_id }} {
      display: block;
      position: relative;
      overflow: hidden;
      padding: 0 16px;
    }

    .ai-how-it-works-slider-{{ ai_gen_id }} {
      display: flex;
      gap: 20px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 20px;
    }

    .ai-how-it-works-slider-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-how-it-works-slide-{{ ai_gen_id }} {
      flex: 0 0 85%;
      scroll-snap-align: start;
    }

    .ai-how-it-works-dots-{{ ai_gen_id }} {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 20px;
    }

    .ai-how-it-works-dot-{{ ai_gen_id }} {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #d1d1d1;
      transition: background-color 0.3s ease;
    }

    .ai-how-it-works-dot-{{ ai_gen_id }}.active {
      background-color: {{ block.settings.step_title_color }};
    }

    .ai-how-it-works-image-wrapper-{{ ai_gen_id }} {
      aspect-ratio: 1 / 1;
    }

    .ai-how-it-works-image-wrapper-{{ ai_gen_id }} img {
      aspect-ratio: 1 / 1;
      object-fit: cover;
    }
  }
{% endstyle %}

<how-it-works-{{ ai_gen_id }} class="ai-how-it-works-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-how-it-works-container-{{ ai_gen_id }}">
    {% if block.settings.main_title != blank %}
      <h2 class="ai-how-it-works-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
    {% endif %}

    <div class="ai-how-it-works-steps-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign step_image_key = 'step_' | append: i | append: '_image'
          assign step_title_key = 'step_' | append: i | append: '_title'
          assign step_description_key = 'step_' | append: i | append: '_description'

          assign step_image = block.settings[step_image_key]
          assign step_title = block.settings[step_title_key]
          assign step_description = block.settings[step_description_key]
        %}

        <div class="ai-how-it-works-step-{{ ai_gen_id }}">
          <div class="ai-how-it-works-image-wrapper-{{ ai_gen_id }}">
            {% if step_image %}
              <img
                src="{{ step_image | image_url: width: 800 }}"
                alt="{{ step_image.alt | escape }}"
                loading="lazy"
                width="{{ step_image.width }}"
                height="{{ step_image.height }}"
              >
            {% else %}
              <div class="ai-how-it-works-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if step_title != blank %}
            <h3 class="ai-how-it-works-step-title-{{ ai_gen_id }}">{{ step_title }}</h3>
          {% endif %}

          {% if step_description != blank %}
            <p class="ai-how-it-works-step-description-{{ ai_gen_id }}">{{ step_description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ai-how-it-works-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-how-it-works-slider-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign step_image_key = 'step_' | append: i | append: '_image'
            assign step_title_key = 'step_' | append: i | append: '_title'
            assign step_description_key = 'step_' | append: i | append: '_description'

            assign step_image = block.settings[step_image_key]
            assign step_title = block.settings[step_title_key]
            assign step_description = block.settings[step_description_key]
          %}

          <div class="ai-how-it-works-slide-{{ ai_gen_id }} ai-how-it-works-step-{{ ai_gen_id }}" data-slide="{{ i }}">
            <div class="ai-how-it-works-image-wrapper-{{ ai_gen_id }}">
              {% if step_image %}
                <img
                  src="{{ step_image | image_url: width: 800 }}"
                  alt="{{ step_image.alt | escape }}"
                  loading="lazy"
                  width="{{ step_image.width }}"
                  height="{{ step_image.height }}"
                >
              {% else %}
                <div class="ai-how-it-works-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if step_title != blank %}
              <h3 class="ai-how-it-works-step-title-{{ ai_gen_id }}">{{ step_title }}</h3>
            {% endif %}

            {% if step_description != blank %}
              <p class="ai-how-it-works-step-description-{{ ai_gen_id }}">{{ step_description }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="ai-how-it-works-dots-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          <div class="ai-how-it-works-dot-{{ ai_gen_id }}" data-dot="{{ i }}"></div>
        {% endfor %}
      </div>
    </div>
  </div>
</how-it-works-{{ ai_gen_id }}>

<script>
  (function() {
    class HowItWorks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.slider = this.querySelector('.ai-how-it-works-slider-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-how-it-works-dot-{{ ai_gen_id }}');
        
        if (!this.slider || this.dots.length === 0) return;

        this.updateActiveDot();
        this.slider.addEventListener('scroll', () => this.updateActiveDot());
      }

      updateActiveDot() {
        const scrollLeft = this.slider.scrollLeft;
        const slideWidth = this.slider.querySelector('.ai-how-it-works-slide-{{ ai_gen_id }}').offsetWidth + 20;
        const activeIndex = Math.round(scrollLeft / slideWidth);

        this.dots.forEach((dot, index) => {
          if (index === activeIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('how-it-works-{{ ai_gen_id }}', HowItWorks{{ ai_gen_id }});
  })();
</script>

