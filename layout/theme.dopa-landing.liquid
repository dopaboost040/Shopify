{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
NOTE TO DEVELOPERS: welcome to Impact theme! We hope that you will enjoy editing this theme as much as we did for
  developing it. We have put a lot of work to make this theme as developer friendly as possible by offering you
  hooks to integrate into critical parts of the theme. You will find the complete technical documentation (including
  all events, dependencies...) in the "documentation.txt" file, located in the Assets folder.
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<!doctype html>

<html lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="theme-color" content="{{ settings.header_background }}">

    <title>{% if page_title == blank %}{{ shop.name }}{% else %}{{ page_title }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% endif %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}Few prefetch to increase performance on commonly used third-parties{%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="dns-prefetch" href="https://productreviews.shopifycdn.com">

    {%- unless settings.heading_font.system? -%}
      <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- unless settings.text_font.system? -%}
      <link rel="preload" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- render 'social-meta-tags' -%}
    {%- render 'microdata-schema' -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    <script type="importmap">
      {%- comment -%}On Safari 16.3 and lower, a polyfill is used to load importmap{%- endcomment -%}
      {
        "imports": {
          "vendor": "{{ 'vendor.min.js' | asset_url }}",
          "theme": "{{ 'theme.js' | asset_url }}",
          "photoswipe": "{{ 'photoswipe.min.js' | asset_url }}"
        }
      }
    </script>

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
    
  </head>

  <body class="{% if settings.zoom_image_on_hover %}zoom-image--enabled{% endif %}">
    {%- render 'shadow-dom-templates' -%}

    <a href="#main" class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- comment -%}
      Dedicated landing-page layout: no header/footer, so there's no nav
      out of this page. Only used by templates that set "layout" to this
      file's name -- theme.liquid (every other page) is untouched.

      Logo is intentionally NOT a link -- linking it to the homepage
      would reopen the exact exit path this layout removes. The cart
      icon on the right is kept (same markup/behavior as the normal
      header) since it opens the cart drawer in place, it doesn't
      navigate anywhere -- customers still need a way to view their
      cart without waiting on Bogos/UpCart's own auto-open.
    {%- endcomment -%}
    <div class="dopa-landing-logo-bar">
      <div class="dopa-landing-logo-bar__spacer" aria-hidden="true"></div>
      <img
        class="dopa-landing-logo-bar__logo"
        src="https://cdn.shopify.com/s/files/1/0930/4218/0471/files/BUY_2_GET_2_FREE_10.png?v=1785161064"
        width="1080"
        height="168"
        alt="{{ shop.name }}"
        loading="eager"
      >
      <a href="{{ routes.cart_url }}" data-no-instant class="dopa-landing-logo-bar__cart relative block tap-area" {% if settings.cart_type != 'page' and request.page_type != 'cart' %}aria-controls="cart-drawer"{% endif %}>
        <span class="sr-only">{{ 'header.general.cart' | t }}</span>
        {%- render 'icon' with 'cart' -%}
        <div class="header__cart-count">
          {%- comment -%}
            Plain span driven by our own script below, not the theme's
            <cart-count> element -- that component infers its previous
            count by re-parsing its own rendered text, which loses track
            when several cart:change events fire in quick succession
            (exactly what happens here: pack + Bogos free-gift add back
            to back) and gets stuck on the first number. This always
            reads the true count straight from the event/cart.js instead.
          {%- endcomment -%}
          <span class="count-bubble {% if cart.item_count == 0 %}opacity-0{% endif %}" data-dopa-cart-badge>
            <span class="sr-only" data-dopa-cart-badge-sr>{{ 'cart.general.item_count' | t: count: cart.item_count }}</span>
            <span aria-hidden="true" data-dopa-cart-badge-num>{{ cart.item_count }}</span>
          </span>
        </div>
      </a>
    </div>
    <script>
      (function () {
        var badge = document.querySelector('[data-dopa-cart-badge]');
        if (!badge) return;
        var num = badge.querySelector('[data-dopa-cart-badge-num]');
        var sr = badge.querySelector('[data-dopa-cart-badge-sr]');

        function update(count) {
          num.textContent = count;
          if (sr) sr.textContent = count + ' item(s) in cart';
          badge.classList.toggle('opacity-0', count === 0);
        }

        document.addEventListener('cart:change', function (e) {
          update(e.detail.cart.item_count);
        });

        document.addEventListener('cart:refresh', function () {
          fetch(window.Shopify.routes.root + 'cart.js')
            .then(function (r) { return r.json(); })
            .then(function (cart) { update(cart.item_count); });
        });
      })();
    </script>
    <style>
      .dopa-landing-logo-bar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 20px var(--spacing-4, 16px) 10px;
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgb(var(--background-primary));
      }
      .dopa-landing-logo-bar__logo {
        height: 14px;
        width: auto;
        justify-self: center;
      }
      .dopa-landing-logo-bar__cart {
        justify-self: end;
      }
      @media screen and (min-width: 750px) {
        .dopa-landing-logo-bar__logo {
          height: 18px;
        }
      }
    </style>
    {%- if request.page_type != 'password' -%}
      {%- sections 'overlay-group' -%}

      {%- if settings.cart_type == 'popover' -%}
        <cart-notification-drawer open-from="bottom" class="quick-buy-drawer drawer"></cart-notification-drawer>
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' -%}
      {%- section 'account-banner' -%}
    {%- endif -%}

    <main role="main" id="main" class="anchor">
      {{ content_for_layout }}

      {%- comment -%}
        The sticky Add to cart bar (product-quick-add custom element,
        assets/theme.js) uses an IntersectionObserver anchored on the
        page's ".footer" element to know when to show/hide -- with no
        footer on this landing page it found nothing and never showed
        at all. This is an invisible marker only (no footer content/
        links), just so that observer has something to anchor to.
      {%- endcomment -%}
      <div class="footer" aria-hidden="true" style="padding: 0 !important; background: transparent !important;"></div>
    </main>
  </body>
</html>