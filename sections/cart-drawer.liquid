    },
    {
      "type": "color",
      "id": "product_card_background",
      "label": "Product card background"
    },
    {
      "type": "color",
      "id": "product_card_text_color",
      "label": "Product card text"
    },
    {
      "type": "header",
      "content": "Trust badges"
    },
    {
      "type": "text",
      "id": "trust_badge_1_text",
      "label": "Badge 1 text",
      "default": "Free Shipping"
    },
    {
      "type": "image_picker",
      "id": "trust_badge_1_image",
      "label": "Badge 1 custom image"
    },
    {
      "type": "text",
      "id": "trust_badge_1_icon",
      "label": "Badge 1 icon (if no image)",
      "default": "picto-truck",
      "info": "Theme icon used if no custom image is uploaded"
    },
    {
      "type": "text",
      "id": "trust_badge_2_text",
      "label": "Badge 2 text",
      "default": "Secure Payment"
    },
    {
      "type": "image_picker",
      "id": "trust_badge_2_image",
      "label": "Badge 2 custom image"
    },
    {
      "type": "text",
      "id": "trust_badge_2_icon",
      "label": "Badge 2 icon (if no image)",
      "default": "picto-lock"
    },
    {
      "type": "text",
      "id": "trust_badge_3_text",
      "label": "Badge 3 text",
      "default": "Easy Returns"
    },
    {
      "type": "image_picker",
      "id": "trust_badge_3_image",
      "label": "Badge 3 custom image"
    },
    {
      "type": "text",
      "id": "trust_badge_3_icon",
      "label": "Badge 3 icon (if no image)",
      "default": "picto-box"
    }
  ]
}
