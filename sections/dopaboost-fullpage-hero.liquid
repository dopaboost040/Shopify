    { "type": "header", "content": "Mobile only — Reasons list" },
    { "type": "paragraph", "content": "Shown only on mobile/tablet screens, below the hero. Add 'Reason' blocks below to populate it. Not shown on desktop." },
    { "type": "checkbox", "id": "show_mobile_reasons", "label": "Show reasons list on mobile", "default": true },
    { "type": "color", "id": "reason_bg_color", "label": "Section background", "default": "#FBFAF5" },
    { "type": "color", "id": "reason_number_color", "label": "Number color", "default": "#1E4620" },
    { "type": "color", "id": "reason_title_color", "label": "Title color", "default": "#1E4620" },
    { "type": "color", "id": "reason_body_color", "label": "Body text color", "default": "#333333" },

    { "type": "header", "content": "Mobile only — Sticky bottom bar" },
    { "type": "paragraph", "content": "A fixed bar pinned to the bottom of the screen on mobile only. Reuses the button/label/rating text from the hero section above." },
    { "type": "checkbox", "id": "show_mobile_sticky_bar", "label": "Show sticky bottom bar on mobile", "default": true },
    { "type": "checkbox", "id": "mobile_sticky_bar_dismissible", "label": "Allow visitors to close it", "default": true },
    { "type": "color", "id": "sticky_bar_bg_color", "label": "Bar background", "default": "#1E4620" },
    { "type": "color", "id": "sticky_bar_text_color", "label": "Rating text color", "default": "#FFFFFF" },
    { "type": "color", "id": "sticky_pill_bg_color", "label": "Pill background", "default": "#E7D600" },
    { "type": "color", "id": "sticky_pill_text_color", "label": "Pill text", "default": "#1A1A1A" },
    { "type": "color", "id": "sticky_button_bg_color", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "sticky_button_text_color", "label": "Button text", "default": "#1A1A1A" }
  ],
  "blocks": [
    {
      "type": "slide",
