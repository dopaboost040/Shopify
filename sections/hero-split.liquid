{%- render 'section-spacing-collapsing' -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background }};
  }

  #shopify-section-{{ section.id }} .hero-split,
  #shopify-section-{{ section.id }} .hero-split * {
    font-family: 'DM Sans', sans-serif;
  }

  #shopify-section-{{ section.id }} .hero-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .hero-split-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .hero-split-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .hero-split-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    padding: {{ section.settings.content_padding }}px;
  }

  #shopify-section-{{ section.id }} .hero-split-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    background-color: {{ section.settings.badge_background }};
    color: {{ section.settings.badge_text_color }};
    padding: 10px 20px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .hero-split-badge-check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: {{ section.settings.badge_check_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .hero-split-rating {
    display: flex;
    align-items: center;
    gap: 10px;
    color: {{ section.settings.star_color }};
    font-size: 20px;
  }

  #shopify-section-{{ section.id }} .hero-split-rating-text {
    color: {{ section.settings.text_color }};
    font-size: 16px;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .hero-split-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 800;
    line-height: 1.05;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }

  #shopify-section-{{ section.id }} .hero-split-description {
    font-size: 18px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
    margin: 0;
    max-width: 560px;
  }

  #shopify-section-{{ section.id }} .hero-split-button-row {
    display: flex;
    justify-content: {{ section.settings.button_align }};
    order: {{ section.settings.button_order }};
  }

  #shopify-section-{{ section.id }} .hero-split-button {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
    color: {{ section.settings.button_text_color }};
    background-color: {{ section.settings.button_background }};
    padding: 18px 36px;
    border-radius: 999px;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .hero-split-button:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .hero-split-features {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    order: 5;
  }

  #shopify-section-{{ section.id }} .hero-split-feature {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .hero-split-feature-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid {{ section.settings.feature_icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.feature_icon_color }};
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .hero-split-feature-label {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
    text-transform: uppercase;
  }

  @media screen and (max-width: 899px) {
    #shopify-section-{{ section.id }} .hero-split {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .hero-split-heading {
      font-size: {{ section.settings.heading_size | times: 0.6 | round }}px;
    }
  }
</style>

<div {% render 'section-properties' %}>
  <div class="hero-split">
    <div class="hero-split-image-wrap">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: sizes: '50vw', widths: '400,600,800,1000,1200', class: 'hero-split-image' }}
      {%- endif -%}
    </div>

    <div class="hero-split-content">
      {%- if section.settings.badge_text != blank -%}
        <div class="hero-split-badge">
          <span class="hero-split-badge-check">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 13l4 4L19 7" stroke="{{ section.settings.badge_background }}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          {{ section.settings.badge_text }}
        </div>
      {%- endif -%}

      {%- if section.settings.rating_text != blank -%}
        <div class="hero-split-rating">
          <span>★★★★★</span>
          <span class="hero-split-rating-text">{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-split-heading hyphenate">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="hero-split-description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <div class="hero-split-button-row">
          <a href="{{ section.settings.button_url | default: '#' }}" class="hero-split-button">
            {{- section.settings.button_text -}}
          </a>
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hero-split-features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="hero-split-feature" {{ block.shopify_attributes }}>
                <span class="hero-split-feature-icon">
                  {%- case block.settings.icon -%}
                    {%- when 'calendar' -%}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    {%- when 'patch' -%}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 3a9 9 0 0 1 9 9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    {%- when 'clock' -%}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  {%- endcase -%}
                </span>
                {%- if block.settings.label != blank -%}
                  <span class="hero-split-feature-label">{{ block.settings.label }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero split",
  "class": "shopify-section--hero-split",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "image_picker",
