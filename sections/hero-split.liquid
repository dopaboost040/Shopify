        { "value": "3 / 4", "label": "3:4 (staand)" },
        { "value": "4 / 3", "label": "4:3 (liggend)" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding rond tekst",
      "default": 64
    },
    {
      "type": "header",
