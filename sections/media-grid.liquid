<div {% render 'section-properties', narrow: section.settings.reduce_width %}>
  <media-grid class="media-grid">
    {%- for block in section.blocks -%}
      <a {% if block.settings.link_url != blank %}href="{{ block.settings.link_url }}"{% endif %} class="media-grid__item shadow group" reveal-js style="--media-grid-column-span: {{ block.settings.desktop_column_span }}; --media-grid-row-span: {{ block.settings.desktop_row_span }}; --description-font-size-mobile: {{ block.settings.description_font_size_mobile }}px; --description-font-size-desktop: {{ block.settings.description_font_size_desktop }}px; --heading-font-size-mobile: {{ block.settings.heading_font_size_mobile }}px; --heading-font-size-desktop: {{ block.settings.heading_font_size_desktop }}px; --icon-size-mobile: {{ block.settings.icon_size_mobile }}px; --icon-size-desktop: {{ block.settings.icon_size_desktop }}px;" {{ block.shopify_attributes }}>
        <div id="media-grid-{{ block.id }}" {% render 'surface', class: 'content-over-media rounded', background: block.settings.background, background_gradient: block.settings.background_gradient, text_color: block.settings.text_color %}>
          {%- liquid
            assign loading_strategy = nil
  
            if section.index > 3 or forloop.index > 3
              assign loading_strategy = 'lazy'
            endif
          -%}
          
          {%- case block.type -%}
            {%- when 'image' -%}
              {%- if block.settings.image -%}
                {%- capture sizes -%}(max-width: 699px) 100vw, min({{ 390 | times: block.settings.desktop_column_span }}px, {{ 25 | times: block.settings.desktop_column_span }}vw){%- endcapture -%}
                {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading_strategy, sizes: sizes, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800,2000,2200,2400', class: 'content-over-media__media zoom-image' -}}
              {%- endif -%}

            {%- when 'video' -%}
              {%- if block.settings.video -%}
                <video-media autoplay style="--aspect-ratio: auto">
                  {%- if block.settings.show_video_controls -%}
                    {%- assign loop_video = false -%}
                  {%- else -%}
                    {%- assign loop_video = true -%}
                  {%- endif -%}

                  {{- block.settings.video | video_tag: 
                    autoplay: true,
                    playsinline: true, 
                    muted: true, 
                    loop: loop_video, 
                    controls: false,
                    preload: 'auto', 
                    class: 'object-fill video-element',
                    data-autoplay: 'true',
                    data-has-controls: block.settings.show_video_controls
                  -}}
                </video-media>
                
                {%- if block.settings.show_video_controls -%}
                  <button class="video-toggle-button" aria-label="Play/Pause video">
                    <svg class="play-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                    <svg class="pause-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
                    </svg>
                  </button>
                {%- else -%}
                  <button class="video-play-button" aria-label="Play video">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                {%- endif -%}
              {%- else -%}
                <video-media host="{{ block.settings.external_video_url.type }}" autoplay style="--aspect-ratio: auto">
                  <template>
                    {%- if block.settings.external_video_url.type == 'youtube' -%}
                      <iframe 
                        src="https://www.youtube.com/embed/{{ block.settings.external_video_url.id }}?playsinline=1&autoplay=1&controls=0&mute=1&loop=1&playlist={{ block.settings.external_video_url.id }}&enablejsapi=1&rel=0&modestbranding=1&disablekb=1&fs=0&iv_load_policy=3&origin={{ 'https://' | append: request.host | url_encode }}" 
                        allow="autoplay; encrypted-media; accelerometer; gyroscope; picture-in-picture" 
                        allowfullscreen="allowfullscreen"
                        loading="lazy"></iframe>
                    {%- elsif block.settings.external_video_url.type == 'vimeo' -%}
                      <iframe 
                        src="https://player.vimeo.com/video/{{ block.settings.external_video_url.id }}?autoplay=1&autopause=0&background=1&loop=1&muted=1&transparent=0&responsive=1&portrait=0&title=0&byline=0&controls=0&color={{ settings.text_color | remove_first: '#' }}" 
                        allow="autoplay; encrypted-media; accelerometer; gyroscope; picture-in-picture" 
                        allowfullscreen="allowfullscreen"
                        loading="lazy"></iframe>
                    {%- endif -%}
                  </template>
                </video-media>
                
                {%- if block.settings.show_video_controls -%}
                  <button class="video-toggle-button" aria-label="Play/Pause video">
                    <svg class="play-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                    <svg class="pause-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
                    </svg>
                  </button>
                {%- else -%}
                  <button class="video-play-button" aria-label="Play video">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                {%- endif -%}
              {%- endif -%}
          {%- endcase -%}

          {%- if block.settings.icon_image != blank or block.settings.title != blank or block.settings.description != blank or block.settings.link_text != blank -%}
            <div class="{{ block.settings.mobile_text_position }} {{ block.settings.desktop_text_position }}">
              <div class="prose">
                {%- comment -%} NEW: Display icon if provided {%- endcomment -%}
                {%- if block.settings.icon_image != blank -%}
                  {{- block.settings.icon_image | image_url: width: 200 | image_tag: loading: loading_strategy, class: 'content-icon', alt: block.settings.title -}}
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <p class="{{ block.settings.heading_tag }} content-heading">
                    {% render 'styled-text', content: block.settings.title, gradient: block.settings.text_gradient %}
                  </p>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <p class="content-description">
                    {{ block.settings.description }}
                  </p>
                {%- endif -%}

                {%- if block.settings.link_text != blank -%}
                  {%- render 'button', size: 'lg', content: block.settings.link_text, background: block.settings.button_background, text_color: block.settings.button_text_color -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </media-grid>
</div>

{%- comment -%}
Additional JavaScript to ensure video autoplay works across all browsers and handle play/pause buttons
{%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const videos = document.querySelectorAll('.media-grid video[data-autoplay="true"]');
    const playButtons = document.querySelectorAll('.video-play-button');
    const toggleButtons = document.querySelectorAll('.video-toggle-button');
    
    playButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const gridItem = this.closest('.media-grid__item');
        const video = gridItem.querySelector('video');
        const videoMedia = gridItem.querySelector('video-media');
        
        if (video) {
          if (video.paused) {
            video.play().then(() => {
              gridItem.classList.add('video-playing');
              this.style.display = 'none';
            }).catch(error => {
              console.log('Video play failed:', error);
            });
          } else {
            video.pause();
            gridItem.classList.remove('video-playing');
            this.style.display = 'flex';
          }
        } else if (videoMedia) {
          const iframe = videoMedia.querySelector('iframe');
          if (iframe) {
            if (iframe.src.includes('youtube')) {
              iframe.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
            } else if (iframe.src.includes('vimeo')) {
              iframe.contentWindow.postMessage('{"method":"play"}', '*');
            }
            gridItem.classList.add('video-playing');
            this.style.display = 'none';
          }
        }
      });
    });
    
    toggleButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const gridItem = this.closest('.media-grid__item');
        const video = gridItem.querySelector('video');
        const videoMedia = gridItem.querySelector('video-media');
        
        if (video) {
          if (video.paused) {
            video.play().then(() => {
              gridItem.classList.add('video-playing');
            }).catch(error => {
              console.log('Video play failed:', error);
            });
          } else {
            video.pause();
            gridItem.classList.remove('video-playing');
          }
        } else if (videoMedia) {
          const iframe = videoMedia.querySelector('iframe');
          if (iframe) {
            const isPlaying = gridItem.classList.contains('video-playing');
            
            if (isPlaying) {
              if (iframe.src.includes('youtube')) {
                iframe.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
              } else if (iframe.src.includes('vimeo')) {
                iframe.contentWindow.postMessage('{"method":"pause"}', '*');
              }
              gridItem.classList.remove('video-playing');
            } else {
              if (iframe.src.includes('youtube')) {
                iframe.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
              } else if (iframe.src.include('vimeo')) {
                iframe.contentWindow.postMessage('{"method":"play"}', '*');
              }
              gridItem.classList.add('video-playing');
            }
          }
        }
      });
    });
    
    if (videos.length > 0) {
      const playVideo = (video) => {
        video.play().catch(function(error) {
          video.muted = true;
          video.play().catch(function(error) {
            console.log('Video autoplay failed:', error);
          });
        });
      };

      videos.forEach(video => {
        const gridItem = video.closest('.media-grid__item');
        const playButton = gridItem ? gridItem.querySelector('.video-play-button') : null;
        const hasControls = video.getAttribute('data-has-controls') === 'true';
        
        video.addEventListener('play', function() {
          if (gridItem) gridItem.classList.add('video-playing');
          if (playButton && !hasControls) playButton.style.display = 'none';
        });
        
        video.addEventListener('pause', function() {
          if (gridItem) gridItem.classList.remove('video-playing');
          if (playButton && !hasControls) playButton.style.display = 'flex';
        });
        
        video.addEventListener('ended', function() {
          if (!video.loop) {
            if (gridItem) gridItem.classList.remove('video-playing');
            if (playButton && !hasControls) playButton.style.display = 'flex';
          }
        });
      });

      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            playVideo(entry.target);
          }
        });
      }, {
        threshold: 0.25
      });

      videos.forEach(video => {
        videoObserver.observe(video);
      });
    }
  });
</script>

{% schema %}
{
  "name": "Media grid",
  "class": "shopify-section--media-grid",
  "tag": "section",
  "disabled_on": {
    "templates": [
      "password"
    ],
    "groups": [
      "header",
      "custom.overlay"
    ]
  },
  "max_blocks": 15,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1000 x 1500px .jpg recommended (portrait) or 1500 x 1500px .jpg recommended (square)"
        },
        {
          "type": "header",
          "content": "Icon (Optional)",
          "info": "Display an icon above the title"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image",
          "info": "Recommended: 100 x 100px PNG with transparent background"
        },
        {
          "type": "range",
          "id": "icon_size_mobile",
          "label": "Icon size (Mobile)",
          "min": 32,
          "max": 120,
          "step": 4,
          "unit": "px",
          "default": 48
        },
        {
          "type": "range",
          "id": "icon_size_desktop",
          "label": "Icon size (Desktop)",
          "min": 40,
          "max": 160,
          "step": 4,
          "unit": "px",
          "default": 64
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Promote your products"
        },
        {
          "type": "range",
          "id": "heading_font_size_mobile",
          "label": "Heading font size (Mobile)",
          "min": 16,
          "max": 48,
          "step": 2,
          "unit": "px",
          "default": 24
        },
        {
          "type": "range",
          "id": "heading_font_size_desktop",
