{% comment %}
  Problem Section - Static Layout WITH GRADIENT ACCENT
  Enhanced version with gradient accent line
  
  INSTALLATION:
  Save as: sections/problem-static.liquid
{% endcomment %}

<style>
  /* ========================================
     PROBLEM SECTION - STATIC WITH GRADIENT ACCENT
     ======================================== */
  .problem-static-section {
    padding: {{ section.settings.section_padding_desktop }};
    background: {{ section.settings.background_color }};
  }

  .problem-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* NEW: Gradient Accent Wrapper */
  .problem-content-wrapper {
    position: relative;
    padding-left: 35px;
  }

  /* NEW: Gradient Accent Line - Coral/Salmon */
  .problem-content-wrapper::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(to bottom, #ff6b6b 0%, #feca57 100%);
    border-radius: 2px;
  }

  /* NEW: Optional Glow Effect */
  .problem-content-wrapper::after {
    content: '';
    position: absolute;
    left: -5px;
    top: 0;
    bottom: 0;
    width: 14px;
    background: linear-gradient(to bottom, rgba(255, 107, 107, 0.15) 0%, rgba(254, 202, 87, 0.15) 100%);
    border-radius: 2px;
    filter: blur(12px);
    z-index: -1;
  }

  /* Section Label */
  .problem-label {
    font-size: {{ section.settings.label_size }}px;
    color: {{ section.settings.label_color }};
    letter-spacing: {{ section.settings.label_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ section.settings.label_margin }}px;
    font-weight: {{ section.settings.label_weight }};
  }

  /* Main Headline */
  .problem-headline {
    font-size: {{ section.settings.headline_size_desktop }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.headline_weight }};
    color: {{ section.settings.headline_color }};
    margin-bottom: {{ section.settings.headline_margin }}px;
    letter-spacing: -0.5px;
  }

  /* NEW: Gradient text for highlight - Coral */
  .problem-headline .highlight {
    font-weight: {{ section.settings.headline_bold_weight }};
    background: linear-gradient(135deg, #ff6b6b 0%, #feca57 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Description - Enhanced with dashed border */
  .problem-description {
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.6;
    color: {{ section.settings.description_color }};
    max-width: {{ section.settings.description_max_width }}px;
    margin-bottom: {{ section.settings.description_margin }}px;
    padding-bottom: 35px;
    font-weight: 300;
    border-bottom: 1px dashed #e0e0e0;
  }

  /* Problem Items Grid */
  .problem-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    margin-top: {{ section.settings.grid_margin_top }}px;
  }

  /* Individual Problem Item - Enhanced */
  .problem-item {
    padding: {{ section.settings.item_padding }};
    text-align: center;
    transition: transform 0.3s ease;
  }

  .problem-item:hover {
    transform: translateY(-5px);
  }

  /* Large Number - Enhanced with coral color */
  .problem-number {
    font-size: {{ section.settings.number_size }}px;
    font-weight: {{ section.settings.number_weight }};
    color: #ff6b6b;
    line-height: 1;
    margin-bottom: {{ section.settings.number_margin }}px;
    letter-spacing: -2px;
  }

  /* Problem Title */
  .problem-item h3 {
    font-size: {{ section.settings.item_title_size }}px;
    font-weight: {{ section.settings.item_title_weight }};
    color: {{ section.settings.item_title_color }};
    margin-bottom: {{ section.settings.item_title_margin }}px;
    line-height: 1.3;
  }

  /* Problem Description */
  .problem-item p {
    font-size: {{ section.settings.item_text_size }}px;
    line-height: 1.6;
    color: {{ section.settings.item_text_color }};
    font-weight: 300;
  }

  /* Responsive - Tablet */
  @media (max-width: 1024px) {
    .problem-static-section {
      padding: {{ section.settings.section_padding_tablet }};
    }

    .problem-content-wrapper {
      padding-left: 25px;
    }

    .problem-content-wrapper::before {
      width: 3px;
    }

    .problem-headline {
      font-size: {{ section.settings.headline_size_tablet }}px;
    }

    .problem-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
      gap: {{ section.settings.grid_gap_tablet }}px;
    }
  }

  /* Responsive - Mobile */
  @media (max-width: 640px) {
    .problem-static-section {
      padding: {{ section.settings.section_padding_mobile }};
    }

    .problem-content-wrapper {
      padding-left: 20px;
    }

    .problem-content-wrapper::before {
      width: 3px;
    }

    .problem-label {
      font-size: {{ section.settings.label_size_mobile }}px;
      margin-bottom: {{ section.settings.label_margin_mobile }}px;
    }

    .problem-headline {
      font-size: {{ section.settings.headline_size_mobile }}px;
      margin-bottom: {{ section.settings.headline_margin_mobile }}px;
    }

    .problem-description {
      font-size: {{ section.settings.description_size_mobile }}px;
      margin-bottom: {{ section.settings.description_margin_mobile }}px;
      padding-bottom: 25px;
    }

    /* Mobile Slider */
    .problem-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 0;
      margin-top: {{ section.settings.grid_margin_top_mobile }}px;
      padding-bottom: 60px;
    }

    .problem-grid::-webkit-scrollbar {
      display: none;
    }

    .problem-item {
      flex: 0 0 85%;
      scroll-snap-align: center;
      padding: {{ section.settings.mobile_card_padding }};
      background: {{ section.settings.mobile_card_background }};
      border-radius: {{ section.settings.mobile_card_radius }}px;
      margin-right: {{ section.settings.mobile_card_gap }}px;
      box-shadow: {{ section.settings.mobile_card_shadow }};
      /* NEW: Gradient border option for mobile cards - Coral */
      border: 2px solid transparent;
      background-image: 
        linear-gradient(white, white),
        linear-gradient(135deg, #ff6b6b, #feca57);
      background-origin: border-box;
      background-clip: padding-box, border-box;
    }

    .problem-item:last-child {
      margin-right: 0;
    }

    .problem-number {
      font-size: {{ section.settings.number_size_mobile }}px;
    }

    .problem-item h3 {
      font-size: {{ section.settings.item_title_size_mobile }}px;
    }

    .problem-item p {
      font-size: {{ section.settings.item_text_size_mobile }}px;
    }
  }

  /* Progress Dots - Mobile Only - ENHANCED with gradient */
  .progress-dots {
    display: none;
  }

  @media (max-width: 640px) {
    .progress-dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 24px;
    }

    .progress-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: {{ section.settings.dot_inactive_color }};
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .progress-dot.active {
      background: linear-gradient(135deg, #ff6b6b 0%, #feca57 100%);
      width: 24px;
      border-radius: 4px;
    }
  }
</style>

<!-- HTML Structure - ENHANCED -->
<section class="problem-static-section">
  <div class="problem-container">
    
    <!-- NEW: Wrapped in content wrapper for accent line -->
    <div class="problem-content-wrapper">
      <!-- Section Label -->
      {% if section.settings.section_label != blank %}
      <div class="problem-label">
        {{ section.settings.section_label }}
      </div>
      {% endif %}

      <!-- Main Headline -->
      {% if section.settings.headline_part1 != blank %}
      <h2 class="problem-headline">
        {{ section.settings.headline_part1 }}
        {% if section.settings.headline_part2 != blank %}
        <span class="highlight">{{ section.settings.headline_part2 }}</span>
        {% endif %}
      </h2>
      {% endif %}

      <!-- Description -->
      {% if section.settings.description != blank %}
      <p class="problem-description">
        {{ section.settings.description }}
      </p>
      {% endif %}

      <!-- Problem Items Grid -->
      <div class="problem-grid" id="problem-grid-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="problem-item" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="problem-number">{{ block.settings.number }}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      </div>

      <!-- Progress Dots - Mobile Only -->
      <div class="progress-dots" id="progress-dots-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="progress-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></div>
        {% endfor %}
      </div>
    </div>

  </div>
</section>

<script>
(function() {
  if (window.innerWidth <= 640) {
    const grid = document.getElementById('problem-grid-{{ section.id }}');
    const dots = document.querySelectorAll('#progress-dots-{{ section.id }} .progress-dot');
    const items = grid.querySelectorAll('.problem-item');
    
    if (!grid || !dots.length) return;

    // Update active dot based on scroll position
    function updateActiveDot() {
      const scrollLeft = grid.scrollLeft;
      const itemWidth = items[0].offsetWidth;
      const gap = {{ section.settings.mobile_card_gap }};
      const currentIndex = Math.round(scrollLeft / (itemWidth + gap));
      
      dots.forEach((dot, index) => {
        if (index === currentIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    // Scroll to item when dot is clicked
    dots.forEach((dot, index) => {
      dot.addEventListener('click', function() {
        const itemWidth = items[0].offsetWidth;
        const gap = {{ section.settings.mobile_card_gap }};
        grid.scrollTo({
          left: (itemWidth + gap) * index,
          behavior: 'smooth'
        });
      });
    });

    // Update dots on scroll
    grid.addEventListener('scroll', updateActiveDot);
    
    // Initial update
    updateActiveDot();
  }
})();
</script>

