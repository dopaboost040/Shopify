{%- if section.blocks.size > 0 -%}
  {%- render 'section-spacing-collapsing' -%}

  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');

    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background-color: {{ section.settings.box_background }};
    }

    #shopify-section-{{ section.id }} .patch-showcase-box,
    #shopify-section-{{ section.id }} .patch-showcase-box * {
      font-family: 'DM Sans', sans-serif;
    }

    #shopify-section-{{ section.id }} .patch-showcase-box {
      background-color: {{ section.settings.box_background }};
      border-radius: {{ section.settings.corner_radius }}px;
      padding: {{ section.settings.box_padding }}px;
    }

    #shopify-section-{{ section.id }} .patch-showcase-inner {
      display: flex;
      align-items: center;
      gap: 48px;
    }

    #shopify-section-{{ section.id }} .patch-showcase-heading {
      flex: 0 0 auto;
      max-width: 320px;
      font-size: 40px;
      font-weight: 700;
      line-height: 1.15;
      color: {{ section.settings.heading_color }};
      margin: 0;
    }

    #shopify-section-{{ section.id }} .patch-showcase-cards {
      display: flex;
      gap: 32px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      flex: 1 1 auto;
      padding-bottom: 4px;
      margin: 0;
      list-style: none;
    }

    #shopify-section-{{ section.id }} .patch-showcase-card {
      flex: 0 0 auto;
      width: 260px;
      text-align: center;
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .patch-showcase-label {
      font-size: 18px;
      color: {{ section.settings.heading_color }};
      margin: 0 0 16px;
    }

    #shopify-section-{{ section.id }} .patch-showcase-image-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .patch-showcase-circle {
      position: absolute;
      width: 82%;
      height: 82%;
      border-radius: 50%;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 0;
    }

    #shopify-section-{{ section.id }} .patch-showcase-image {
      position: relative;
      z-index: 1;
      max-width: 96%;
      max-height: 96%;
      object-fit: contain;
      display: block;
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .patch-showcase-title {
      font-size: 20px;
      font-weight: 600;
      color: {{ section.settings.heading_color }};
      margin: 0 0 20px;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .patch-showcase-inner {
        flex-direction: column;
        align-items: flex-start;
        gap: 24px;
      }

      #shopify-section-{{ section.id }} .patch-showcase-heading {
        max-width: 100%;
        font-size: 28px;
      }

      #shopify-section-{{ section.id }} .patch-showcase-card {
        width: 190px;
      }

      #shopify-section-{{ section.id }} .patch-showcase-box {
        width: 100vw;
        max-width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        border-radius: 0;
        padding-top: {{ section.settings.box_padding | at_most: 32 }}px;
        padding-bottom: {{ section.settings.box_padding | at_most: 32 }}px;
        padding-left: 20px;
        padding-right: 20px;
        overflow-x: hidden; /* voorkomt dat de hele box breder wordt dan het scherm */
      }

      #shopify-section-{{ section.id }} .patch-showcase-cards {
        width: 100%;                       /* cruciaal: anders groeit de lijst mee met alle kaarten i.p.v. te scrollen */
        max-width: 100%;
        min-width: 0;                      /* laat flex-items daadwerkelijk krimpen zodat overflow-x kan werken */
        -webkit-overflow-scrolling: touch;  /* soepel touch-scrollen op iOS */
        scrollbar-width: none;              /* Firefox */
        -ms-overflow-style: none;           /* IE/Edge */
      }

      #shopify-section-{{ section.id }} .patch-showcase-cards::-webkit-scrollbar {
        width: 0;
        height: 0;
        background: transparent;     /* Chrome, Safari, iOS - i.p.v. display:none, want dat kan scrollen blokkeren op iOS */
      }
    }
  </style>

  <div {% render 'section-properties' %}>
    <div class="patch-showcase-box">
      <div class="patch-showcase-inner">
        {%- if section.settings.heading != blank -%}
          <p class="patch-showcase-heading hyphenate">{{ section.settings.heading }}</p>
        {%- endif -%}

        <ul class="patch-showcase-cards" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_card' -%}
              <li class="patch-showcase-card" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}
                  <p class="patch-showcase-label">{{ block.settings.label | escape }}</p>
                {%- endif -%}

                <div class="patch-showcase-image-wrap">
                  {%- if block.settings.circle_color != blank -%}
                    <span class="patch-showcase-circle" style="background-color: {{ block.settings.circle_color }};"></span>
                  {%- endif -%}
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 500 | image_tag: sizes: '260px', widths: '180,260,360,500', class: 'patch-showcase-image' }}
                  {%- endif -%}
                </div>

                {%- if block.settings.title != blank -%}
                  <p class="patch-showcase-title">{{ block.settings.title | escape }}</p>
                {%- endif -%}

                {%- if block.settings.button_text != blank -%}
                  {% render 'button', content: block.settings.button_text, href: block.settings.button_url, size: 'base', style: 'fill', background: block.settings.button_background, text_color: block.settings.button_text_color, block: block %}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product showcase",
  "class": "shopify-section--patch-showcase",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Patches to get you through any day"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Tekstkleur",
      "default": "#1F2340"
    },
    {
      "type": "header",
      "content": "Box"
    },
    {
      "type": "color",
      "id": "box_background",
      "label": "Achtergrondkleur",
      "default": "#E7E7E7"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Afronding hoeken",
      "default": 24
    },
    {
      "type": "range",
      "id": "box_padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Binnenkant padding box",
      "default": 64
    },
    {
      "type": "header",
      "content": "Padding sectie"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding boven",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding onder",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label (bv. Morning)",
          "default": "Morning"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Productafbeelding",
          "info": "Vierkante afbeelding met transparante achtergrond werkt het best"
        },
        {
          "type": "color",
          "id": "circle_color",
          "label": "Cirkelkleur achter afbeelding",
          "default": "#E9E28B"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Product naam"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Knoptekst",
          "default": "Shop nu"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Knoplink"
        },
        {
          "type": "color",
          "id": "button_background",
          "label": "Knop achtergrondkleur",
          "default": "#1F2340"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Knop tekstkleur",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product showcase",
      "category": "Content",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "label": "Morning",
            "title": "Energy Patches - Extra Strong",
            "button_text": "Shop Energy",
            "circle_color": "#E9E28B"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "label": "Daytime",
            "title": "Unpuff Patches",
            "button_text": "Shop Unpuff",
            "circle_color": "#A9D6C7"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "label": "Night",
            "title": "Dream Patches - Magnesium",
            "button_text": "Shop Dream",
            "circle_color": "#A9C6E0"
          }
        }
      ]
    }
  ]
}
{% endschema %}
