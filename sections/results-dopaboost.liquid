{% comment %}
  Results Section - DopaBoost
  Variation 1: Clean Circles - Minimalistic design with soft beige colors
  
  INSTALLATION:
  Save as: sections/results-dopaboost.liquid
{% endcomment %}

<style>
  /* ========================================
     RESULTS SECTION - VARIATION 1
     ======================================== */
  .results-section-{{ section.id }} {
    padding: {{ section.settings.section_padding_desktop }};
    background: {{ section.settings.background_color }};
    margin-top: {{ section.settings.margin_top_desktop }}px;
    margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
  }

  .results-container-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Section Label */
  .section-label-{{ section.id }} {
    font-size: {{ section.settings.label_size }}px;
    color: {{ section.settings.label_color }};
    letter-spacing: {{ section.settings.label_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ section.settings.label_margin }}px;
    font-weight: {{ section.settings.label_weight }};
    text-align: center;
  }

  /* Headline */
  .headline-{{ section.id }} {
    font-size: {{ section.settings.headline_size_desktop }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.headline_weight }};
    color: {{ section.settings.headline_color }};
    margin-bottom: {{ section.settings.headline_margin }}px;
    text-align: center;
  }

  .headline-{{ section.id }} .highlight {
    font-weight: {{ section.settings.headline_highlight_weight }};
  }

  /* Stats Grid */
  .stats-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    margin: {{ section.settings.grid_margin_top }}px 0 {{ section.settings.grid_margin_bottom }}px;
  }

  /* Stat Item */
  .stat-item-{{ section.id }} {
    text-align: center;
  }

  /* Circle Wrapper */
  .circle-wrap-{{ section.id }} {
    width: {{ section.settings.circle_size }}px;
    height: {{ section.settings.circle_size }}px;
    margin: 0 auto {{ section.settings.circle_margin }}px;
    position: relative;
  }

  .circle-svg-{{ section.id }} {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .circle-bg-{{ section.id }} {
    fill: none;
    stroke: {{ section.settings.circle_bg_color }};
    stroke-width: {{ section.settings.circle_stroke_width }};
  }

  .circle-progress-{{ section.id }} {
    fill: none;
    stroke: {{ section.settings.circle_color }};
    stroke-width: {{ section.settings.circle_stroke_width }};
    stroke-linecap: round;
    stroke-dasharray: 283;
    stroke-dashoffset: 283;
    transition: stroke-dashoffset 2s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .stat-item-{{ section.id }}.animate .circle-progress-{{ section.id }} {
    stroke-dashoffset: calc(283 - (283 * var(--progress) / 100));
  }

  /* Circle Text (Percentage) */
  .circle-text-{{ section.id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: {{ section.settings.percentage_size }}px;
    font-weight: {{ section.settings.percentage_weight }};
    color: {{ section.settings.percentage_color }};
    opacity: 0;
    animation: fadeIn-{{ section.id }} 0.6s ease forwards 1.5s;
  }

  @keyframes fadeIn-{{ section.id }} {
    to { opacity: 1; }
  }

  .circle-text-{{ section.id }} .percent {
    font-size: {{ section.settings.percent_symbol_size }}px;
    opacity: {{ section.settings.percent_symbol_opacity }};
  }

  /* Stat Description */
  .stat-description-{{ section.id }} {
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.6;
    color: {{ section.settings.description_color }};
    max-width: {{ section.settings.description_max_width }}px;
    margin: 0 auto;
  }

  /* Footer Text */
  .footer-text-{{ section.id }} {
    text-align: center;
    margin-top: {{ section.settings.footer_margin_top }}px;
    font-size: {{ section.settings.footer_size }}px;
    color: {{ section.settings.footer_color }};
    letter-spacing: {{ section.settings.footer_spacing }}px;
    text-transform: uppercase;
  }

  /* Responsive - Tablet */
  @media (max-width: 1024px) {
    .results-section-{{ section.id }} {
      padding: {{ section.settings.section_padding_tablet }};
    }

    .headline-{{ section.id }} {
      font-size: {{ section.settings.headline_size_tablet }}px;
    }

    .stats-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
      gap: {{ section.settings.grid_gap_tablet }}px;
    }
  }

  /* Responsive - Mobile */
  @media (max-width: 768px) {
    .results-section-{{ section.id }} {
      padding: {{ section.settings.section_padding_mobile }};
      margin-top: {{ section.settings.margin_top_mobile }}px;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    }

    .section-label-{{ section.id }} {
      font-size: {{ section.settings.label_size_mobile }}px;
      margin-bottom: {{ section.settings.label_margin_mobile }}px;
    }

    .headline-{{ section.id }} {
      font-size: {{ section.settings.headline_size_mobile }}px;
      margin-bottom: {{ section.settings.headline_margin_mobile }}px;
    }

    .stats-grid-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: {{ section.settings.grid_gap_mobile }}px;
      margin: {{ section.settings.grid_margin_top_mobile }}px 0 {{ section.settings.grid_margin_bottom_mobile }}px;
    }

    .circle-wrap-{{ section.id }} {
      width: {{ section.settings.circle_size_mobile }}px;
      height: {{ section.settings.circle_size_mobile }}px;
    }

    .circle-text-{{ section.id }} {
      font-size: {{ section.settings.percentage_size_mobile }}px;
    }

    .stat-description-{{ section.id }} {
      font-size: {{ section.settings.description_size_mobile }}px;
    }

    .footer-text-{{ section.id }} {
      margin-top: {{ section.settings.footer_margin_top_mobile }}px;
      font-size: {{ section.settings.footer_size_mobile }}px;
    }
  }
</style>

<!-- HTML Structure -->
<section class="results-section-{{ section.id }}" id="results-section-{{ section.id }}">
  <div class="results-container-{{ section.id }}">
    
    <!-- Section Label -->
    {% if section.settings.section_label != blank %}
    <div class="section-label-{{ section.id }}">
      {{ section.settings.section_label }}
    </div>
    {% endif %}

    <!-- Headline -->
    {% if section.settings.headline_part1 != blank %}
    <h2 class="headline-{{ section.id }}">
      {{ section.settings.headline_part1 }}
      {% if section.settings.headline_part2 != blank %}
      <span class="highlight">{{ section.settings.headline_part2 }}</span>
      {% endif %}
    </h2>
    {% endif %}

    <!-- Stats Grid -->
    <div class="stats-grid-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="stat-item-{{ section.id }}" style="--progress: {{ block.settings.percentage }}" {{ block.shopify_attributes }}>
          
          <div class="circle-wrap-{{ section.id }}">
            <svg class="circle-svg-{{ section.id }}" viewBox="0 0 100 100">
              <circle class="circle-bg-{{ section.id }}" cx="50" cy="50" r="45"></circle>
              <circle class="circle-progress-{{ section.id }}" cx="50" cy="50" r="45"></circle>
            </svg>
            <div class="circle-text-{{ section.id }}">
              {{ block.settings.percentage }}<span class="percent">%</span>
            </div>
          </div>

          <p class="stat-description-{{ section.id }}">{{ block.settings.description }}</p>

        </div>
      {% endfor %}
    </div>

    <!-- Footer Text -->
    {% if section.settings.footer_text != blank %}
    <div class="footer-text-{{ section.id }}">
      {{ section.settings.footer_text }}
    </div>
    {% endif %}

  </div>
</section>

<script>
(function() {
  const section = document.getElementById('results-section-{{ section.id }}');
  if (!section) return;
  
  const statItems = section.querySelectorAll('.stat-item-{{ section.id }}');
  let hasAnimated = false;

  function checkVisibility() {
    if (hasAnimated) return;
    
    const rect = section.getBoundingClientRect();
    const isVisible = rect.top < window.innerHeight * 0.8;
    
    if (isVisible) {
      hasAnimated = true;
      
      statItems.forEach((item, index) => {
        setTimeout(() => {
          item.classList.add('animate');
        }, index * {{ section.settings.stagger_delay }});
      });
      
      window.removeEventListener('scroll', checkVisibility);
    }
  }

  window.addEventListener('scroll', checkVisibility, { passive: true });
  checkVisibility();
})();
</script>

