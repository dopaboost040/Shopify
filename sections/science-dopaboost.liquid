{% comment %}
  Science Section - DopaBoost
  DESKTOP: Version 5 - Refined Minimal (horizontal split layout with top borders)
  MOBILE: Version 4 - Tab Navigation (horizontal tabs with content panels)
  Dark "How They Work Together" section at bottom
  
  INSTALLATION:
  Save as: sections/science-dopaboost.liquid
{% endcomment %}

<style>
  /* ========================================
     SCIENCE SECTION - DESKTOP VERSION 5
     ======================================== */
  .science-section {
    padding: {{ section.settings.section_padding_desktop }};
    background: {{ section.settings.background_color }};
  }

  .science-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Section Label */
  .science-label {
    font-size: {{ section.settings.label_size }}px;
    color: {{ section.settings.label_color }};
    letter-spacing: {{ section.settings.label_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ section.settings.label_margin }}px;
    font-weight: {{ section.settings.label_weight }};
  }

  /* Main Headline */
  .science-headline {
    font-size: {{ section.settings.headline_size_desktop }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.headline_weight }};
    color: {{ section.settings.headline_color }};
    margin-bottom: {{ section.settings.headline_margin }}px;
    letter-spacing: -0.5px;
  }

  .science-headline .highlight {
    font-weight: {{ section.settings.headline_highlight_weight }};
    color: {{ section.settings.headline_highlight_color }};
  }

  /* DESKTOP: 2x2 Grid Layout */
  .ingredients-desktop {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ section.settings.desktop_card_gap }}px;
    margin-top: {{ section.settings.grid_margin_top }}px;
    margin-bottom: {{ section.settings.grid_margin_bottom }}px;
  }

  /* Special handling for 3 ingredients - center the third one */
  .ingredients-desktop.has-three .ingredient-desktop-card:nth-child(3) {
    grid-column: 1 / -1;
    max-width: 50%;
    margin-left: auto;
    margin-right: auto;
  }

  /* Special handling for odd numbers (5, 7, etc) - center the last one */
  .ingredients-desktop.has-odd .ingredient-desktop-card:last-child {
    grid-column: 1 / -1;
    max-width: 50%;
    margin-left: auto;
    margin-right: auto;
  }

  .ingredient-desktop-card {
    background: transparent;
    padding: {{ section.settings.desktop_card_padding_box }};
    border-top: {{ section.settings.desktop_border_width }}px solid {{ section.settings.desktop_border_color }};
    transition: all 0.3s ease;
  }

  .ingredient-desktop-card:nth-child(odd) {
    border-left: 0;
  }

  .ingredient-desktop-card:nth-child(even) {
    border-left: {{ section.settings.desktop_border_width }}px solid {{ section.settings.desktop_border_color }};
  }

  .ingredient-desktop-card:nth-child(n+3) {
    border-bottom: {{ section.settings.desktop_border_width }}px solid {{ section.settings.desktop_border_color }};
  }

  .ingredient-desktop-card:hover {
    padding-left: 20px;
  }

  .desktop-left {
    display: flex;
    flex-direction: column;
    margin-bottom: {{ section.settings.category_margin }}px;
  }

  .desktop-category {
    font-size: {{ section.settings.category_size }}px;
    letter-spacing: 2.5px;
    color: {{ section.settings.category_color }};
    text-transform: uppercase;
    margin-bottom: {{ section.settings.category_margin }}px;
    font-weight: 600;
  }

  .desktop-title {
    font-size: {{ section.settings.ingredient_name_size }}px;
    font-weight: {{ section.settings.ingredient_name_weight }};
    color: {{ section.settings.ingredient_name_color }};
    margin-bottom: {{ section.settings.ingredient_name_margin }}px;
  }

  .desktop-right {
    display: block;
  }

  .desktop-description {
    font-size: {{ section.settings.ingredient_text_size }}px;
    line-height: 1.8;
    color: {{ section.settings.ingredient_text_color }};
  }

  /* MOBILE: Tab Navigation - Hidden on Desktop */
  .ingredients-mobile {
    display: none;
  }

  /* Dark Footer Section */
  .synergy-section {
    background: {{ section.settings.synergy_background }};
    padding: {{ section.settings.synergy_padding }};
    border-radius: {{ section.settings.synergy_border_radius }}px;
    text-align: center;
    margin-top: {{ section.settings.synergy_margin_top }}px;
  }

  .synergy-title {
    font-size: {{ section.settings.synergy_title_size }}px;
    font-weight: {{ section.settings.synergy_title_weight }};
    color: {{ section.settings.synergy_title_color }};
    margin-bottom: {{ section.settings.synergy_title_margin }}px;
    line-height: 1.3;
  }

  .synergy-description {
    font-size: {{ section.settings.synergy_text_size }}px;
    line-height: 1.7;
    color: {{ section.settings.synergy_text_color }};
    max-width: {{ section.settings.synergy_text_max_width }}px;
    margin: 0 auto;
    font-weight: 300;
  }

  /* Responsive - Tablet */
  @media (max-width: 1024px) and (min-width: 769px) {
    .science-section {
      padding: {{ section.settings.section_padding_tablet }};
    }

    .science-headline {
      font-size: {{ section.settings.headline_size_tablet }}px;
    }

    .ingredients-desktop {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ingredient-desktop-card {
      padding: 35px 30px;
    }

    .desktop-title {
      font-size: 22px;
    }

    .desktop-description {
      font-size: 14px;
    }

    .synergy-title {
      font-size: {{ section.settings.synergy_title_size_tablet }}px;
    }
  }

  /* Responsive - Mobile: Switch to Tab Navigation */
  @media (max-width: 768px) {
    .science-section {
      padding: {{ section.settings.section_padding_mobile }};
    }

    .science-label {
      font-size: {{ section.settings.label_size_mobile }}px;
      margin-bottom: {{ section.settings.label_margin_mobile }}px;
      text-align: center;
    }

    .science-headline {
      font-size: {{ section.settings.headline_size_mobile }}px;
      margin-bottom: {{ section.settings.headline_margin_mobile }}px;
      text-align: center;
    }

    /* Hide Desktop Layout */
    .ingredients-desktop {
      display: none;
    }

    /* Show Mobile Tab Navigation */
    .ingredients-mobile {
      display: block;
      margin-top: {{ section.settings.grid_margin_top_mobile }}px;
      margin-bottom: {{ section.settings.grid_margin_bottom_mobile }}px;
    }

    .mobile-tabs {
      display: flex;
      overflow-x: auto;
      gap: {{ section.settings.mobile_tab_gap }}px;
      padding: 0 0 {{ section.settings.mobile_tabs_padding_bottom }}px 0;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin-bottom: {{ section.settings.mobile_tabs_margin }}px;
    }

    .mobile-tabs::-webkit-scrollbar {
      display: none;
    }

    .mobile-tab {
      padding: {{ section.settings.mobile_tab_padding }};
      background: transparent;
      border: {{ section.settings.mobile_tab_border_width }}px solid {{ section.settings.mobile_tab_border_color }};
      border-radius: {{ section.settings.mobile_tab_border_radius }}px;
      font-size: {{ section.settings.mobile_tab_font_size }}px;
      font-weight: {{ section.settings.mobile_tab_font_weight }};
      color: {{ section.settings.mobile_tab_color }};
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.3s ease;
      flex-shrink: 0;
      -webkit-tap-highlight-color: rgba(0,0,0,0.1);
      user-select: none;
    }

    .mobile-tab.active {
      background: {{ section.settings.mobile_tab_active_bg }};
      color: {{ section.settings.mobile_tab_active_color }};
      border-color: {{ section.settings.mobile_tab_active_border }};
    }

    .mobile-content {
      padding: 0;
    }

    .mobile-panel {
      display: none;
      background: {{ section.settings.mobile_panel_bg }};
      padding: {{ section.settings.mobile_panel_padding }};
      border-radius: {{ section.settings.mobile_panel_border_radius }}px;
      animation: fadeIn 0.3s ease;
    }

    .mobile-panel.active {
      display: block;
    }

    @keyframes fadeIn {
      from { 
        opacity: 0; 
        transform: translateY(10px); 
      }
      to { 
        opacity: 1; 
        transform: translateY(0); 
      }
    }

    .mobile-category {
      font-size: {{ section.settings.category_size }}px;
      letter-spacing: 2px;
      color: {{ section.settings.category_color }};
      text-transform: uppercase;
      margin-bottom: {{ section.settings.category_margin }}px;
      font-weight: 600;
    }

    .mobile-title {
      font-size: {{ section.settings.ingredient_name_size_mobile }}px;
      font-weight: {{ section.settings.ingredient_name_weight }};
      color: {{ section.settings.ingredient_name_color }};
      margin-bottom: {{ section.settings.ingredient_name_margin }}px;
    }

    .mobile-description {
      font-size: {{ section.settings.ingredient_text_size_mobile }}px;
      line-height: 1.75;
      color: {{ section.settings.ingredient_text_color }};
    }

    .synergy-section {
      padding: {{ section.settings.synergy_padding_mobile }};
      margin-top: {{ section.settings.synergy_margin_top_mobile }}px;
    }

    .synergy-title {
      font-size: {{ section.settings.synergy_title_size_mobile }}px;
      margin-bottom: {{ section.settings.synergy_title_margin_mobile }}px;
    }

    .synergy-description {
      font-size: {{ section.settings.synergy_text_size_mobile }}px;
    }
  }
</style>

<!-- HTML Structure -->
<section class="science-section">
  <div class="science-container">
    
    <!-- Section Label -->
    {% if section.settings.section_label != blank %}
    <div class="science-label">
      {{ section.settings.section_label }}
    </div>
    {% endif %}

    <!-- Main Headline -->
    {% if section.settings.headline_part1 != blank %}
    <h2 class="science-headline">
      {{ section.settings.headline_part1 }}
      {% if section.settings.headline_part2 != blank %}
      <span class="highlight">{{ section.settings.headline_part2 }}</span>
      {% endif %}
    </h2>
    {% endif %}

    <!-- DESKTOP: 2x2 Grid Layout -->
    {% assign ingredient_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'ingredient' %}
        {% assign ingredient_count = ingredient_count | plus: 1 %}
      {% endif %}
    {% endfor %}
    
    {% assign is_odd = ingredient_count | modulo: 2 %}
    
    <div class="ingredients-desktop{% if ingredient_count == 3 %} has-three{% elsif is_odd == 1 %} has-odd{% endif %}">
      {% for block in section.blocks %}
        {% if block.type == 'ingredient' %}
        <div class="ingredient-desktop-card" {{ block.shopify_attributes }}>
          {% if block.settings.category != blank %}
          <div class="desktop-category">{{ block.settings.category }}</div>
          {% endif %}
          <div class="desktop-title">{{ block.settings.name }}</div>
          <div class="desktop-description">{{ block.settings.description }}</div>
        </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- MOBILE: Tab Navigation -->
    <div class="ingredients-mobile">
      <div class="mobile-tabs">
        {% for block in section.blocks %}
          {% if block.type == 'ingredient' %}
          <div class="mobile-tab{% if forloop.index0 == 0 %} active{% endif %}" 
               data-tab-index="{{ forloop.index0 }}"
               data-section-id="{{ section.id }}"
               {{ block.shopify_attributes }}>
            {{ block.settings.name }}
          </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="mobile-content">
        {% for block in section.blocks %}
          {% if block.type == 'ingredient' %}
          <div class="mobile-panel{% if forloop.index0 == 0 %} active{% endif %}" 
               data-panel-index="{{ forloop.index0 }}"
               {{ block.shopify_attributes }}>
            {% if block.settings.category != blank %}
            <div class="mobile-category">{{ block.settings.category }}</div>
            {% endif %}
            <div class="mobile-title">{{ block.settings.name }}</div>
            <div class="mobile-description">{{ block.settings.description }}</div>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Dark Synergy Section -->
    {% if section.settings.show_synergy_section %}
    <div class="synergy-section">
      {% if section.settings.synergy_title != blank %}
      <h3 class="synergy-title">{{ section.settings.synergy_title }}</h3>
      {% endif %}
      
      {% if section.settings.synergy_text != blank %}
      <p class="synergy-description">{{ section.settings.synergy_text }}</p>
      {% endif %}
    </div>
    {% endif %}

  </div>
</section>

<script>
// Tab switching for section {{ section.id }}
(function() {
  function initMobileTabs() {
    var sectionId = 'shopify-section-{{ section.id }}';
    var section = document.getElementById(sectionId);
    
    if (!section) {
      setTimeout(initMobileTabs, 100);
      return;
    }

    var tabs = section.querySelectorAll('.mobile-tab');
    var panels = section.querySelectorAll('.mobile-panel');

    if (tabs.length === 0 || panels.length === 0) {
      setTimeout(initMobileTabs, 100);
      return;
    }

    for (var i = 0; i < tabs.length; i++) {
      (function(index) {
        tabs[index].onclick = function() {
          // Remove active from all tabs
          for (var j = 0; j < tabs.length; j++) {
            tabs[j].classList.remove('active');
          }
          
          // Remove active from all panels
          for (var k = 0; k < panels.length; k++) {
            panels[k].classList.remove('active');
          }
          
          // Add active to clicked tab and corresponding panel
          tabs[index].classList.add('active');
          panels[index].classList.add('active');
        };
      })(i);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileTabs);
  } else {
    initMobileTabs();
  }
})();
</script>

