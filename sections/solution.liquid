{% comment %}
  Solution Section - DopaBoost (WITH GRADIENT FEATURE LABELS + CTA)
  Split layout: sticky image on left, scrolling features on right

  INSTALLATION:
  Save as: sections/solution-dopaboost.liquid
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');

  /* ========================================
     SOLUTION SECTION
     ======================================== */
  .solution-section,
  .solution-section * {
    font-family: 'DM Sans', sans-serif;
  }

  .solution-section {
    padding: 0 {{ section.settings.section_padding_sides }}px;
    padding-top: 0;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    background: {{ section.settings.background_color }};
    margin-top: 0;
    margin-bottom: 0;
  }

  .solution-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Section Label */
  .solution-label {
    font-size: {{ section.settings.label_size }}px;
    color: {{ section.settings.label_color }};
    letter-spacing: {{ section.settings.label_spacing }}px;
    text-transform: uppercase;
    margin-bottom: {{ section.settings.label_margin }}px;
    font-weight: {{ section.settings.label_weight }};
    margin-top: 0;
    padding-top: 0;
  }

  /* Main Headline */
  .solution-headline {
    font-size: {{ section.settings.headline_size_desktop }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.headline_weight }};
    color: {{ section.settings.headline_color }};
    margin-bottom: {{ section.settings.headline_margin }}px;
    letter-spacing: -0.5px;
    margin-top: 0;
  }

  .solution-headline .highlight {
    font-weight: {{ section.settings.headline_bold_weight }};
  }

  /* Split Layout */
  .solution-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.split_gap }}px;
    align-items: start;
    margin-top: {{ section.settings.content_margin_top }}px;
  }

  /* Left: Sticky Image */
  .solution-image-wrapper {
    position: sticky;
    top: {{ section.settings.sticky_top }}px;
    align-self: start;
    margin-bottom: 0;
  }

  .solution-image {
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    background: {{ section.settings.image_placeholder_color }};
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .solution-image img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
  }

  /* Right: Content Area */
  .solution-content {
    padding: 0;
  }

  /* Intro Text */
  .solution-intro {
    font-size: {{ section.settings.intro_size }}px;
    line-height: 1.7;
    color: {{ section.settings.intro_color }};
    margin-bottom: {{ section.settings.intro_margin }}px;
    font-weight: 300;
  }

  /* Features List */
  .features-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Individual Feature */
  .feature-item {
    padding: 0;
    margin-bottom: {{ section.settings.feature_gap_desktop }}px;
  }

  .feature-item:last-child {
    margin-bottom: 0;
  }

  /* Feature Label with Gradient */
  .feature-label {
    font-size: {{ section.settings.feature_label_size }}px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: {{ section.settings.feature_label_margin }}px;
    font-weight: 500;

    {% if section.settings.enable_feature_gradient %}
    /* Gradient text effect */
    background: linear-gradient(
      {{ section.settings.feature_gradient_angle }}deg,
      {{ section.settings.feature_gradient_start }} 0%,
      {{ section.settings.feature_gradient_end }} 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
    {% else %}
    color: {{ section.settings.feature_label_color }};
    {% endif %}
  }

  /* Fallback for browsers that don't support text gradients */
  @supports not (-webkit-background-clip: text) {
    .feature-label {
      color: {{ section.settings.feature_label_fallback }};
    }
  }

  /* Feature Title */
  .feature-item h3 {
    font-size: {{ section.settings.feature_title_size }}px;
    font-weight: {{ section.settings.feature_title_weight }};
    color: {{ section.settings.feature_title_color }};
    margin-top: 0;
    margin-bottom: {{ section.settings.feature_title_margin }}px;
    line-height: 1.3;
  }

  /* Feature Description */
  .feature-item p {
    font-size: {{ section.settings.feature_text_size }}px;
    line-height: 1.6;
    color: {{ section.settings.feature_text_color }};
    font-weight: 300;
    margin: 0;
  }

  /* Call To Action */
  .solution-cta-wrapper {
    margin-top: {{ section.settings.cta_margin_top }}px;
  }

  .solution-cta-button {
    display: inline-block;
    text-decoration: none;
    text-align: center;
    padding: {{ section.settings.cta_padding_vertical }}px {{ section.settings.cta_padding_horizontal }}px;
    background: {{ section.settings.cta_bg_color }};
    color: {{ section.settings.cta_text_color }};
    font-size: {{ section.settings.cta_font_size }}px;
    font-weight: {{ section.settings.cta_font_weight }};
    border-radius: {{ section.settings.cta_border_radius }}px;
    letter-spacing: 0.3px;
    transition: opacity 0.2s ease, transform 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .solution-cta-button:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  /* Responsive - Tablet */
  @media (max-width: 1024px) {
    .solution-section {
      padding: 0 {{ section.settings.section_padding_sides_tablet }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_tablet }}px;
    }

    .solution-headline {
      font-size: {{ section.settings.headline_size_tablet }}px;
    }

    .solution-split {
      gap: {{ section.settings.split_gap_tablet }}px;
    }
  }

  /* Responsive - Mobile */
  @media (max-width: 768px) {
    .solution-section {
      padding: 0 {{ section.settings.section_padding_sides_mobile }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
    }

    .solution-label {
      font-size: {{ section.settings.label_size_mobile }}px;
      margin-bottom: {{ section.settings.label_margin_mobile }}px;
      margin-top: 0;
    }

    .solution-headline {
      font-size: {{ section.settings.headline_size_mobile }}px;
      margin-bottom: {{ section.settings.headline_margin_mobile }}px;
    }

    .solution-split {
      grid-template-columns: 1fr;
      gap: {{ section.settings.split_gap_mobile }}px;
      margin-top: {{ section.settings.content_margin_top_mobile }}px;
    }

    .solution-image-wrapper {
      position: relative;
      top: 0;
      margin-bottom: 0;
      /* Robust full-bleed technique: breaks out of any parent width regardless of padding value */
      width: 100vw;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
    }

    .solution-image {
      aspect-ratio: {{ section.settings.image_aspect_ratio_mobile }};
      border-radius: {{ section.settings.image_border_radius_mobile }}px !important;
    }

    .solution-image img {
      border-radius: {{ section.settings.image_border_radius_mobile }}px !important;
    }

    .solution-content {
      padding: 0 0 0;
    }

    .solution-intro {
      font-size: {{ section.settings.intro_size_mobile }}px;
      margin-bottom: {{ section.settings.intro_margin_mobile }}px;
    }

    .feature-item {
      margin-bottom: {{ section.settings.feature_gap_mobile }}px;
    }

    .feature-item:last-child {
      margin-bottom: 0;
    }

    .feature-item h3 {
      font-size: {{ section.settings.feature_title_size_mobile }}px;
    }

    .feature-item p {
      font-size: {{ section.settings.feature_text_size_mobile }}px;
    }

    .solution-cta-wrapper {
      margin-top: {{ section.settings.cta_margin_top_mobile }}px;
    }
  }
</style>

<!-- HTML Structure -->
<section class="solution-section">
  <div class="solution-container">

    <!-- Section Label -->
    {% if section.settings.section_label != blank %}
    <div class="solution-label">
      {{ section.settings.section_label }}
    </div>
    {% endif %}

    <!-- Main Headline -->
    {% if section.settings.headline_part1 != blank %}
    <h2 class="solution-headline">
      {{ section.settings.headline_part1 }}
      {% if section.settings.headline_part2 != blank %}
      <span class="highlight">{{ section.settings.headline_part2 }}</span>
      {% endif %}
    </h2>
    {% endif %}

    <!-- Split Layout -->
    <div class="solution-split">

      <!-- Left: Sticky Image -->
      <div class="solution-image-wrapper">
        <div class="solution-image">
          {% if section.settings.image != blank %}
            <img
              src="{{ section.settings.image | image_url: width: 800 }}"
              srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                      {{ section.settings.image | image_url: width: 800 }} 800w,
                      {{ section.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 768px) 100vw, 50vw"
              alt="{{ section.settings.image.alt | escape }}"
              loading="lazy"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>

      <!-- Right: Content -->
      <div class="solution-content">

        <!-- Intro Text -->
        {% if section.settings.intro_text != blank %}
        <p class="solution-intro">
          {{ section.settings.intro_text }}
        </p>
        {% endif %}

        <!-- Features List -->
        <div class="features-list">
          {% for block in section.blocks %}
            <div class="feature-item" {{ block.shopify_attributes }}>
              {% if block.settings.feature_label != blank %}
              <div class="feature-label">{{ block.settings.feature_label }}</div>
              {% endif %}
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.description }}</p>
            </div>
          {% endfor %}
        </div>

        <!-- Call To Action -->
        {% if section.settings.cta_text != blank %}
        <div class="solution-cta-wrapper">
          <a href="{{ section.settings.cta_link | default: '#' }}" class="solution-cta-button">
            {{ section.settings.cta_text }}
          </a>
        </div>
        {% endif %}

      </div>

    </div>

  </div>
</section>

