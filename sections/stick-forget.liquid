{%- if section.blocks.size > 0 -%}
  {%- render 'section-spacing-collapsing' -%}

  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');

    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background-color: {{ section.settings.background }};
    }

    #shopify-section-{{ section.id }} .stick-forget,
    #shopify-section-{{ section.id }} .stick-forget * {
      font-family: 'DM Sans', sans-serif;
    }

    #shopify-section-{{ section.id }} .stick-forget {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: 0 24px;
    }

    #shopify-section-{{ section.id }} .stick-forget-heading {
      font-size: 44px;
      font-weight: 800;
      line-height: 1.1;
      color: {{ section.settings.heading_color }};
      margin: 0 0 48px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .stick-forget-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 48px;
      padding: 0;
      list-style: none;
    }

    #shopify-section-{{ section.id }} .stick-forget-image-wrap {
      width: 100%;
      aspect-ratio: {{ section.settings.image_ratio }};
      border-radius: {{ section.settings.image_radius }}px;
      overflow: hidden;
      margin-bottom: 28px;
      background-color: #e5e5e5;
    }

    #shopify-section-{{ section.id }} .stick-forget-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #shopify-section-{{ section.id }} .stick-forget-caption {
      font-size: 24px;
      font-weight: 700;
      text-transform: uppercase;
      color: {{ section.settings.heading_color }};
      text-align: center;
      margin: 0 0 24px;
    }

    #shopify-section-{{ section.id }} .stick-forget-checklist {
      list-style: none;
      margin: 0 0 24px;
      padding: 0;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .stick-forget-checklist li {
      font-size: 20px;
      font-weight: 600;
      text-transform: uppercase;
      color: {{ section.settings.heading_color }};
      margin-bottom: 6px;
    }

    #shopify-section-{{ section.id }} .stick-forget-checklist li::before {
      content: '✔ ';
      color: {{ section.settings.check_color }};
    }

    #shopify-section-{{ section.id }} .stick-forget-button-row {
      display: flex;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .stick-forget-button {
      display: inline-block;
      font-family: 'DM Sans', sans-serif;
      font-size: 18px;
      font-weight: 700;
      text-decoration: none;
      color: {{ section.settings.button_text_color }};
      background-color: {{ section.settings.button_background }};
      padding: 18px 36px;
      border-radius: 999px;
      transition: opacity 0.2s ease;
    }

    #shopify-section-{{ section.id }} .stick-forget-button:hover {
      opacity: 0.85;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .stick-forget-heading {
        font-size: 32px;
      }

      #shopify-section-{{ section.id }} .stick-forget-caption {
        font-size: 20px;
      }

      #shopify-section-{{ section.id }} .stick-forget-checklist li {
        font-size: 17px;
      }
    }
  </style>

  <div {% render 'section-properties' %}>
    <div class="stick-forget">
      {%- if section.settings.heading != blank -%}
        <h2 class="stick-forget-heading hyphenate">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <ul class="stick-forget-grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'column' -%}
            <li {{ block.shopify_attributes }}>
              <div class="stick-forget-image-wrap">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: sizes: '(max-width: 749px) 100vw, 45vw', widths: '400,600,800,900', class: 'stick-forget-image' }}
                {%- endif -%}
              </div>

              {%- if block.settings.caption != blank -%}
                <p class="stick-forget-caption">{{ block.settings.caption }}</p>
              {%- endif -%}

              {%- if block.settings.checklist != blank -%}
                <ul class="stick-forget-checklist">
                  {%- assign items = block.settings.checklist | newline_to_br | split: '<br />' -%}
                  {%- for item in items -%}
                    {%- if item != blank -%}
                      <li>{{ item | strip }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if block.settings.button_text != blank -%}
                <div class="stick-forget-button-row">
                  <a href="{{ block.settings.button_url | default: '#' }}" class="stick-forget-button">
                    {{- block.settings.button_text -}}
                  </a>
                </div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Stick it & Forget it",
  "class": "shopify-section--stick-forget",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stick it & Forget it"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "label": "Maximale breedte",
      "default": 1280
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Beeldverhouding afbeeldingen",
      "options": [
        { "value": "1 / 1", "label": "Vierkant" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "3 / 4", "label": "3:4 (staand)" },
        { "value": "16 / 9", "label": "16:9" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Afronding afbeelding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Achtergrondkleur sectie",
      "default": "#F2F0EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Kop-, caption- en checklistkleur",
      "default": "#1F2340"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Kleur vinkjes",
      "default": "#1F2340"
    },
    {
      "type": "header",
      "content": "Knop"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Knop achtergrondkleur",
      "default": "#E8A798"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Knop tekstkleur",
      "default": "#1F2340"
    },
    {
      "type": "header",
      "content": "Padding sectie"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding boven",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding onder",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Kolom",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption / titel",
          "default": "Caption tekst"
        },
        {
          "type": "textarea",
          "id": "checklist",
          "label": "Checklist (optioneel, 1 item per regel)",
          "info": "Laat leeg als je geen checklist wilt tonen"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Knoptekst (optioneel)",
          "info": "Laat leeg als je geen knop wilt tonen"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Knoplink"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stick it & Forget it",
      "category": "Content",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "caption": "This is the easiest thing I've ever stuck with",
            "checklist": "No pills\nNo prep\nNo excuses"
          }
        },
        {
          "type": "column",
          "settings": {
            "caption": "Are you ready to see results?",
            "button_text": "Shop Berberine Patches"
          }
        }
      ]
    }
  ]
}
{% endschema %}
