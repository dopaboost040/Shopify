{% comment %}
  Technology Section - DopaBoost
  
  INSTALLATION:
  1. Save this file as: sections/technology-dopaboost.liquid
  2. Go to Shopify Admin > Online Store > Themes > Customize
  3. Click "Add section" and find "Technology DopaBoost"
{% endcomment %}

<style>
  /* ========================================
     FONT LOADING
     ======================================== */
  {{ section.settings.label_font | font_face: font_display: 'swap' }}
  {{ section.settings.title_font | font_face: font_display: 'swap' }}
  {{ section.settings.feature_title_font | font_face: font_display: 'swap' }}
  {{ section.settings.feature_text_font | font_face: font_display: 'swap' }}

  /* ========================================
     TECHNOLOGY SECTION STYLES
     ======================================== */
  .technology-dopaboost-section {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.section_padding_desktop }};
    position: relative;
  }

  .technology-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Section Label */
  .technology-section-label {
    font-size: {{ section.settings.label_size }}px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.label_color }};
    margin-bottom: {{ section.settings.label_margin }}px;
    font-family: {{ section.settings.label_font.family }}, {{ section.settings.label_font.fallback_families }};
    font-style: {{ section.settings.label_font.style }};
    font-weight: {{ section.settings.label_font.weight }};
  }

  /* Main Title */
  .technology-title {
    font-size: {{ section.settings.title_size_desktop }}px;
    line-height: 1.2;
    color: {{ section.settings.title_color }};
    margin-bottom: {{ section.settings.title_margin }}px;
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
    font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    font-style: {{ section.settings.title_font.style }};
    font-weight: {{ section.settings.title_font.weight }};
  }

  .technology-title .regular-text {
    font-weight: {{ section.settings.title_regular_weight }};
  }

  .technology-title .light-text {
    font-weight: {{ section.settings.title_light_weight }};
  }

  /* Features Grid */
  .technology-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  /* Individual Feature */
  .technology-feature {
    padding: {{ section.settings.feature_padding }};
    border-top: {{ section.settings.feature_border_width }}px solid {{ section.settings.feature_border_color }};
    {% if section.settings.feature_background != 'rgba(0,0,0,0)' %}
    background: {{ section.settings.feature_background }};
    border-radius: {{ section.settings.feature_border_radius }}px;
    {% endif %}
  }

  /* Feature Header (Icon + Title) */
  .technology-feature-header {
    display: flex;
    align-items: center;
    gap: {{ section.settings.icon_spacing }}px;
    margin-bottom: {{ section.settings.feature_title_margin }}px;
  }

  /* Feature Icon */
  .technology-feature-icon {
    flex-shrink: 0;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .technology-feature-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Feature Title */
  .technology-feature h3 {
    font-size: {{ section.settings.feature_title_size }}px;
    font-weight: {{ section.settings.feature_title_weight }};
    color: {{ section.settings.feature_title_color }};
    line-height: 1.3;
    margin: 0;
    font-family: {{ section.settings.feature_title_font.family }}, {{ section.settings.feature_title_font.fallback_families }};
    font-style: {{ section.settings.feature_title_font.style }};
    font-weight: {{ section.settings.feature_title_font.weight }};
  }

  /* Feature Description */
  .technology-feature p {
    font-size: {{ section.settings.feature_text_size }}px;
    color: {{ section.settings.feature_text_color }};
    line-height: 1.7;
    margin: 0;
    font-family: {{ section.settings.feature_text_font.family }}, {{ section.settings.feature_text_font.fallback_families }};
    font-style: {{ section.settings.feature_text_font.style }};
    font-weight: {{ section.settings.feature_text_font.weight }};
  }

  /* ========================================
     RESPONSIVE - TABLET
     ======================================== */
  @media (max-width: 1024px) {
    .technology-dopaboost-section {
      padding: {{ section.settings.section_padding_tablet }};
    }

    .technology-title {
      font-size: {{ section.settings.title_size_tablet }}px;
    }

    .technology-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
      gap: {{ section.settings.grid_gap_tablet }}px;
    }

    .technology-feature-icon {
      width: {{ section.settings.icon_size_tablet }}px;
      height: {{ section.settings.icon_size_tablet }}px;
    }
  }

  /* ========================================
     RESPONSIVE - MOBILE
     ======================================== */
  @media (max-width: 640px) {
    .technology-dopaboost-section {
      padding: {{ section.settings.section_padding_mobile }};
    }

    .technology-title {
      font-size: {{ section.settings.title_size_mobile }}px;
      margin-bottom: {{ section.settings.title_margin_mobile }}px;
    }

    .technology-grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.grid_gap_mobile }}px;
    }

    .technology-feature h3 {
      font-size: {{ section.settings.feature_title_size_mobile }}px;
    }

    .technology-feature p {
      font-size: {{ section.settings.feature_text_size_mobile }}px;
    }

    .technology-feature-icon {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
    }

    .technology-feature-header {
      gap: {{ section.settings.icon_spacing_mobile }}px;
    }
  }
</style>

<!-- HTML Structure -->
<section class="technology-dopaboost-section">
  <div class="technology-container">
    
    {% if section.settings.section_label != blank %}
    <div class="technology-section-label">{{ section.settings.section_label }}</div>
    {% endif %}

    {% if section.settings.title_part1 != blank or section.settings.title_part2 != blank %}
    <h2 class="technology-title">
      <span class="regular-text">{{ section.settings.title_part1 }}</span>
      {% if section.settings.title_part2 != blank %}
      <span class="light-text">{{ section.settings.title_part2 }}</span>
      {% endif %}
    </h2>
    {% endif %}

    <div class="technology-grid">
      {% for block in section.blocks %}
        <div class="technology-feature" {{ block.shopify_attributes }}>
          
          <div class="technology-feature-header">
            {% if block.settings.feature_icon != blank %}
              <div class="technology-feature-icon">
                <img src="{{ block.settings.feature_icon | img_url: 'master' }}" alt="{{ block.settings.feature_title }}" loading="lazy">
              </div>
            {% endif %}
            <h3>{{ block.settings.feature_title }}</h3>
          </div>

          <p>{{ block.settings.feature_description }}</p>

        </div>
      {% endfor %}
    </div>

  </div>
</section>

