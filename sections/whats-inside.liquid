          "settings": {
            "title": "5-HTP",
            "dosage": "5mg",
            "description": "Helps support balanced mood and emotional well-being as part of your daily routine."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Lion's Mane Mushroom",
            "dosage": "4.5mg",
            "description": "A functional mushroom traditionally used to support focus, clarity, and overall brain wellness."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Rhodiola Extract",
            "dosage": "3.5mg",
            "description": "An adaptogenic herb that helps support resilience and balance during everyday stress."
          }
        }
      ]
    }
  ]
}
{% endschema %}
