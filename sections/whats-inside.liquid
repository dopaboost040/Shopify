{%- if section.blocks.size > 0 -%}
  {%- render 'section-spacing-collapsing' -%}

  {%- case section.settings.button_size -%}
    {%- when 'sm' -%}
      {%- assign btn_desktop_font = '14px' -%}
      {%- assign btn_desktop_padding = '12px 24px' -%}
    {%- when 'base' -%}
      {%- assign btn_desktop_font = '16px' -%}
      {%- assign btn_desktop_padding = '15px 32px' -%}
    {%- when 'xl' -%}
      {%- assign btn_desktop_font = '20px' -%}
      {%- assign btn_desktop_padding = '20px 48px' -%}
    {%- else -%}
      {%- assign btn_desktop_font = '18px' -%}
      {%- assign btn_desktop_padding = '18px 40px' -%}
  {%- endcase -%}

  {%- assign btn_mobile_size = section.settings.button_mobile_size -%}
  {%- if btn_mobile_size == 'same' or btn_mobile_size == blank -%}
    {%- assign btn_mobile_size = section.settings.button_size -%}
  {%- endif -%}

  {%- case btn_mobile_size -%}
    {%- when 'sm' -%}
      {%- assign btn_mobile_font = '14px' -%}
      {%- assign btn_mobile_padding = '12px 24px' -%}
    {%- when 'base' -%}
      {%- assign btn_mobile_font = '16px' -%}
      {%- assign btn_mobile_padding = '15px 32px' -%}
    {%- when 'xl' -%}
      {%- assign btn_mobile_font = '20px' -%}
      {%- assign btn_mobile_padding = '20px 48px' -%}
    {%- else -%}
      {%- assign btn_mobile_font = '18px' -%}
      {%- assign btn_mobile_padding = '18px 40px' -%}
  {%- endcase -%}

  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');

    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background-color: {{ section.settings.background }};
    }

    #shopify-section-{{ section.id }} .whats-inside,
    #shopify-section-{{ section.id }} .whats-inside * {
      font-family: 'DM Sans', sans-serif;
    }

    #shopify-section-{{ section.id }} .whats-inside {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: 0 24px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .whats-inside-heading {
      font-size: 44px;
      font-weight: 800;
      line-height: 1.1;
      color: {{ section.settings.heading_color }};
      margin: 0 0 20px;
    }

    #shopify-section-{{ section.id }} .whats-inside-subheading {
      font-size: 20px;
      font-weight: 400;
      line-height: 1.5;
      color: {{ section.settings.text_color }};
      max-width: 760px;
      margin: 0 auto 48px;
    }

    #shopify-section-{{ section.id }} .whats-inside-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 32px;
      margin: 0 0 48px;
      padding: 0;
      list-style: none;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .whats-inside-image-wrap {
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: {{ section.settings.image_radius }}px;
      overflow: hidden;
      margin-bottom: 20px;
      background-color: #f0f0f0;
    }

    #shopify-section-{{ section.id }} .whats-inside-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #shopify-section-{{ section.id }} .whats-inside-title {
      font-size: 24px;
      font-weight: 700;
      color: {{ section.settings.heading_color }};
      margin: 0 0 6px;
    }

    #shopify-section-{{ section.id }} .whats-inside-dosage {
      display: inline-block;
      font-size: 15px;
      color: {{ section.settings.dosage_color }};
      background-color: {{ section.settings.dosage_background }};
      padding: 2px 8px;
      border-radius: 6px;
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .whats-inside-description {
      font-size: 16px;
      line-height: 1.5;
      color: {{ section.settings.text_color }};
      margin: 0;
    }

    #shopify-section-{{ section.id }} .whats-inside-button {
      display: inline-block;
      font-family: 'DM Sans', sans-serif;
      font-size: {{ btn_mobile_font }};
      font-weight: 700;
      text-decoration: none;
      color: {{ section.settings.button_text_color }};
      background-color: {{ section.settings.button_background }};
      padding: {{ btn_mobile_padding }};
      border-radius: 999px;
      transition: opacity 0.2s ease;
    }

    #shopify-section-{{ section.id }} .whats-inside-button:hover {
      opacity: 0.85;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .whats-inside-heading {
        font-size: 32px;
      }

      #shopify-section-{{ section.id }} .whats-inside-subheading {
        font-size: 17px;
      }

      #shopify-section-{{ section.id }} .whats-inside-grid {
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 20px;
      }
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .whats-inside-button {
        font-size: {{ btn_desktop_font }};
        padding: {{ btn_desktop_padding }};
      }
    }
  </style>

  <div {% render 'section-properties' %}>
    <div class="whats-inside">
      {%- if section.settings.heading != blank -%}
        <h2 class="whats-inside-heading hyphenate">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="whats-inside-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <ul class="whats-inside-grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'ingredient' -%}
            <li class="whats-inside-item" {{ block.shopify_attributes }}>
              <div class="whats-inside-image-wrap">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 600 | image_tag: sizes: '(max-width: 749px) 45vw, 280px', widths: '200,300,400,600', class: 'whats-inside-image' }}
                {%- endif -%}
              </div>

              {%- if block.settings.title != blank -%}
                <p class="whats-inside-title">{{ block.settings.title | escape }}</p>
              {%- endif -%}

              {%- if block.settings.dosage != blank -%}
                <span class="whats-inside-dosage">{{ block.settings.dosage | escape }}</span>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="whats-inside-description">{{ block.settings.description }}</p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_url | default: '#' }}" class="whats-inside-button">
          {{- section.settings.button_text -}}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "What's Inside",
  "class": "shopify-section--whats-inside",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's Inside"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A thoughtfully selected blend of plant extracts, amino acids, and essential vitamins — delivered in an easy-to-use patch format."
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "label": "Maximale breedte",
      "default": 1280
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Achtergrondkleur sectie",
      "default": "#F2F0EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Kop- en titelkleur",
      "default": "#1F2340"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstkleur",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "dosage_color",
      "label": "Doseringstekstkleur",
      "default": "#8A8A8A"
    },
    {
      "type": "color",
      "id": "dosage_background",
      "label": "Dosering achtergrond",
      "default": "#EAEAEA"
    },
    {
      "type": "header",
      "content": "Afbeeldingen"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Afronding hoeken afbeelding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Knop"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Knoptekst",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Knoplink"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Grootte",
      "options": [
        {
          "value": "sm",
          "label": "Klein"
        },
        {
          "value": "base",
          "label": "Middel"
        },
        {
          "value": "lg",
          "label": "Groot"
        },
        {
          "value": "xl",
          "label": "X-Groot"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "button_mobile_size",
      "label": "Grootte (mobiel)",
      "options": [
        {
          "value": "same",
          "label": "Zelfde als desktop"
        },
        {
          "value": "sm",
          "label": "Klein"
        },
        {
          "value": "base",
          "label": "Middel"
        },
        {
          "value": "lg",
          "label": "Groot"
        },
        {
          "value": "xl",
          "label": "X-Groot"
        }
      ],
      "default": "same"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Knop achtergrondkleur",
      "default": "#F4D35E"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Knop tekstkleur",
      "default": "#1F2340"
    },
    {
      "type": "header",
      "content": "Padding sectie"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding boven",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding onder",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingrediënt",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Naam ingrediënt",
          "default": "Ingrediënt naam"
        },
        {
          "type": "text",
          "id": "dosage",
          "label": "Dosering (bv. 12mg)",
          "default": "10mg"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Beschrijving",
          "default": "Korte beschrijving van het effect of doel van dit ingrediënt."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What's Inside",
      "category": "Content",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "title": "Mucuna Pruiens Extract",
            "dosage": "12mg",
