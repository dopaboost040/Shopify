{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
ACCORDION COMPONENT
----------------------------------------------------------------------------------------------------------------------

This component is used to create an accordion (also called as collapsible). It internally uses the "details" HTML
tag so that it can also be used without any JavaScript.

********************************************
Supported parameters
********************************************

* title: the title to use for the toggle button
* icon: an optional icon attached to the title
* icon_width: an optional icon width (only work for image icons)
* content: the hidden content inside the accordion
* open: if set to true the accordion is open by default
* size: if set to "lg", the font is and spacing is bigger
* class: any additional class
* id: an optional ID for the accordion
* margin_top_mobile: optional margin top value for mobile (e.g., "20px", "1rem")
* margin_bottom_mobile: optional margin bottom value for mobile (e.g., "20px", "1rem")
* margin_top_desktop: optional margin top value for desktop (e.g., "20px", "1rem")
* margin_bottom_desktop: optional margin bottom value for desktop (e.g., "20px", "1rem")
{%- endcomment -%}

<style>
.accordion-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  background: transparent !important;
  color: #000000;
  position: relative;
}

.accordion-icon svg {
  width: 16px;
  height: 16px;
  position: absolute;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.accordion-icon .icon-plus {
  opacity: 1;
  transform: rotate(0deg);
}

.accordion-icon .icon-minus {
  opacity: 0;
  transform: rotate(90deg);
}

details[open] .accordion-icon .icon-plus {
  opacity: 0;
  transform: rotate(90deg);
}

details[open] .accordion-icon .icon-minus {
  opacity: 1;
  transform: rotate(0deg);
}

{% if margin_top_mobile or margin_bottom_mobile or margin_top_desktop or margin_bottom_desktop %}
  #accordion-{{ id | default: 'custom' }} {
    {% if margin_top_mobile %}margin-top: {{ margin_top_mobile }};{% endif %}
    {% if margin_bottom_mobile %}margin-bottom: {{ margin_bottom_mobile }};{% endif %}
  }
  
  @media screen and (min-width: 768px) {
    #accordion-{{ id | default: 'custom' }} {
      {% if margin_top_desktop %}margin-top: {{ margin_top_desktop }};{% endif %}
      {% if margin_bottom_desktop %}margin-bottom: {{ margin_bottom_desktop }};{% endif %}
    }
  }
{% endif %}
</style>

<details 
  id="accordion-{{ id | default: 'custom' }}"
  class="{{ class }} accordion {% if size %}accordion--{{ size }}{% endif %} group" 
  aria-expanded="{% if open %}true{% else %}false{% endif %}" 
  is="accordion-disclosure" 
  {% if open %}open{% endif %} 
  {{ block.shopify_attributes }}>
  <summary>
    {%- comment -%}iOS 14 does not support flex on the summary itself, so we have to use this extra div{%- endcomment -%}
    <div class="accordion__toggle bold">
      {%- if icon -%}
        <div class="text-with-icon">
          {%- if icon.src != blank -%}
            {% capture icon_sizes %}{{ icon_width | default: 20 }}px{%- endcapture -%}
            {% capture icon_widths %}{{ icon_width }},{{ icon_width | times: 2 }},{{ icon_width | times: 3 }}{%- endcapture -%}
            {% capture icon_style %}--image-max-width: {{ icon_sizes }}{%- endcapture -%}

            {{- icon | image_url: width: icon.width | image_tag: loading: 'lazy', sizes: icon_sizes, widths: icon_widths, style: icon_style -}}
          {%- else -%}
            {%- render 'icon' with icon, width: icon_width -%}
          {%- endif -%}

          <span {% if size == 'lg' %}class="h6"{% endif %}>{{- title | escape -}}</span>
        </div>
      {%- else -%}
        <span {% if size == 'lg' %}class="h6"{% endif %}>{{- title | escape -}}</span>
      {%- endif -%}

      <span class="accordion-icon">
        <svg class="icon-plus" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M8 3V13M3 8H13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <svg class="icon-minus" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8H13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </span>
    </div>
  </summary>

  <div class="accordion__content">
    {{- content -}}
  </div>
</details>