{%- comment -%}
  Custom subscribe/one-time buy-box for pack-tier products (1 Pack / 3 Pack / 6 Pack).
  Replaces the Recharge widget's UI only — Recharge still processes the
  subscription once `selling_plan` reaches checkout via the Cart AJAX API.

  Requires: variants titled "N Pack" (N = 1, 3, 6, ...), each already priced
  as the full bundle total, with a matching "N Pack(s) - Subscribe & Save"
  selling plan attached (percentage-off, matched here by name).

  Gift-to-tier mapping is NOT derivable from Liquid (Shopify doesn't expose
  Buy-X-Get-Y discount rules to the storefront object model), so it is
  declared explicitly below. It must stay in sync with the automatic
  discounts configured in Shopify admin. Real price/title/image for each
  gift still comes from the live product via `all_products`, nothing is
  hardcoded except which gift belongs to which pack size.

  CSS lives in assets/theme.css (.sbx rules) and JS in
  assets/bundle-buybox.js. Deliberately written with only for/if/unless/
  continue/assign/capture — no `push`/`first`/`null`, in case this
  theme's Liquid build doesn't support the newer array filters (that's
  the leading suspect for this block rendering as silent empty output
  on the storefront despite being correctly stored and a real, non-
  sandboxed theme block).
{%- endcomment -%}

{%- assign has_pack_variant = false -%}
{%- assign one_pack_price = 0 -%}
{%- assign first_pack_variant_id = 0 -%}
{%- for v in product.variants -%}
  {%- if v.title contains 'Pack' -%}
    {%- assign has_pack_variant = true -%}
    {%- if first_pack_variant_id == 0 -%}
      {%- assign first_pack_variant_id = v.id -%}
    {%- endif -%}
  {%- endif -%}
  {%- if v.title == '1 Pack' -%}
    {%- assign one_pack_price = v.price -%}
  {%- endif -%}
{%- endfor -%}

{%- if has_pack_variant -%}
  {%- capture product_form_id -%}product-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}
  {%- assign is_first_tile = true -%}

  <div class="sbx" data-sbx data-sbx-mode="onetime" data-cart-add-url="{{ routes.cart_add_url }}" data-cart-url="{{ routes.cart_url }}">
    <div class="sbx__mode" role="radiogroup" aria-label="Purchase option">
      <button type="button" class="sbx__mode-btn" data-sbx-mode="onetime" role="radio" aria-checked="true">
        <span class="sbx__mode-title">One-Time Purchase</span>
      </button>
      <button type="button" class="sbx__mode-btn" data-sbx-mode="sub" role="radio" aria-checked="false">
        <span class="sbx__mode-title">Subscribe & Save</span>
        <span class="sbx__mode-sub">Extra 20% OFF + FREE GIFT!</span>
      </button>
    </div>

    <div class="sbx__trust" data-sbx-trust>
      <div class="sbx__trust-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span>Skip or Cancel Anytime</span>
      </div>
      <div class="sbx__trust-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12l2.5 2.5L16 9"/></svg>
        <span>Free Gift on First Order</span>
      </div>
    </div>

    <div class="sbx__tiles">
      {%- for variant in product.variants -%}
        {%- unless variant.title contains 'Pack' -%}
          {%- continue -%}
        {%- endunless -%}

        {%- assign packs = variant.title | remove: ' Pack' | remove: 's' | strip | plus: 0 -%}
        {%- if packs == 0 -%}{%- assign packs = 1 -%}{%- endif -%}

        {%- assign per_pack = variant.price | divided_by: packs -%}
        {%- assign anchor = one_pack_price | times: packs -%}
        {%- if variant.compare_at_price and variant.compare_at_price > anchor -%}
          {%- assign anchor = variant.compare_at_price -%}
        {%- endif -%}
        {%- assign show_compare = false -%}
        {%- if anchor > variant.price -%}{%- assign show_compare = true -%}{%- endif -%}

        {%- assign plan_id = '' -%}
        {%- assign plan_price = variant.price -%}
        {%- for spg in variant.selling_plan_allocations -%}
          {%- if spg.selling_plan.name contains variant.title -%}
            {%- assign plan_id = spg.selling_plan.id -%}
            {%- assign plan_price = spg.price -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign gift_count = 0 -%}
        {%- assign gift_handle_1 = '' -%}
        {%- assign gift_handle_2 = '' -%}
        {%- if variant.title == '3 Pack' -%}
          {%- assign gift_count = 1 -%}
          {%- assign gift_handle_1 = 'energy-patches' -%}
        {%- elsif variant.title == '6 Pack' -%}
          {%- assign gift_count = 2 -%}
          {%- assign gift_handle_1 = 'energy-patches' -%}
          {%- assign gift_handle_2 = 'stress-down-patches' -%}
        {%- endif -%}

        {%- assign gift_variant_ids = '' -%}
        {%- if gift_handle_1 != '' -%}
          {%- assign gp1 = all_products[gift_handle_1] -%}
          {%- if gp1 -%}{%- assign gift_variant_ids = gp1.selected_or_first_available_variant.id -%}{%- endif -%}
        {%- endif -%}
        {%- if gift_handle_2 != '' -%}
          {%- assign gp2 = all_products[gift_handle_2] -%}
          {%- if gp2 -%}{%- assign gift_variant_ids = gift_variant_ids | append: ',' | append: gp2.selected_or_first_available_variant.id -%}{%- endif -%}
        {%- endif -%}

        <div class="sbx__tile{% if is_first_tile %} sbx__tile--selected{% endif %}{% if gift_count > 0 %} sbx__tile--has-gifts{% endif %}"
             data-sbx-tile
             data-variant-id="{{ variant.id }}"
             data-plan-id="{{ plan_id }}"
             data-price-onetime="{{ variant.price }}"
             data-price-sub="{{ plan_price }}"
             data-gift-variant-ids="{{ gift_variant_ids }}"
             data-packs="{{ packs }}"
             data-compare="{% if show_compare %}{{ anchor }}{% else %}0{% endif %}"
             data-title="{{ variant.title }}"
             role="radio"
             aria-checked="{% if is_first_tile %}true{% else %}false{% endif %}"
             tabindex="{% if is_first_tile %}0{% else %}-1{% endif %}">
          <div class="sbx__tile-row">
            <div class="sbx__tile-img sbx__tile-img--p{{ packs | at_most: 6 }}">
              {%- if product.featured_image -%}
                {%- for i in (1..packs) -%}
                  {%- if i > 6 -%}{%- break -%}{%- endif -%}
                  {{ product.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: variant.title, class: 'sbx__tile-img-el' }}
                {%- endfor -%}
              {%- endif -%}
            </div>
            <div class="sbx__tile-body">
              <div class="sbx__tile-title-row">
                <span class="sbx__tile-title">{{ variant.title | replace: '3 Pack', '3 Packs' | replace: '6 Pack', '6 Packs' }}</span>
                {%- if variant.title == '3 Pack' -%}
                  <span class="sbx__badge">BUY 2 GET 1 FREE</span>
                {%- endif -%}
              </div>
              <span class="sbx__chip">{{ per_pack | money }} per pack</span>
              <span class="sbx__supply">{{ packs }} month(s) supply</span>
            </div>
            <div class="sbx__tile-price">
              <span class="sbx__price" data-sbx-price>{{ variant.price | money }}</span>
              {%- if show_compare -%}
                <span class="sbx__compare" data-sbx-compare>{{ anchor | money }}</span>
              {%- endif -%}
            </div>
          </div>
          {%- if gift_count == 1 -%}
            <div class="sbx__ribbon">Free Gift 🎁</div>
          {%- elsif gift_count == 2 -%}
            <div class="sbx__ribbon">{{ gift_count }} Free Gifts 🎁</div>
          {%- endif -%}
          {%- if gift_handle_1 != '' -%}
            {%- assign gift_product = all_products[gift_handle_1] -%}
            {%- if gift_product -%}
              <div class="sbx__gift-row">
                {%- if gift_product.featured_image -%}
                  {{ gift_product.featured_image | image_url: width: 60 | image_tag: loading: 'lazy', alt: gift_product.title, class: 'sbx__gift-img' }}
                {%- endif -%}
                <span class="sbx__gift-label">+ FREE {{ gift_product.title }}</span>
                <span class="sbx__gift-value">{{ gift_product.price | money }}</span>
              </div>
            {%- endif -%}
          {%- endif -%}
          {%- if gift_handle_2 != '' -%}
            {%- assign gift_product = all_products[gift_handle_2] -%}
            {%- if gift_product -%}
              <div class="sbx__gift-row">
                {%- if gift_product.featured_image -%}
                  {{ gift_product.featured_image | image_url: width: 60 | image_tag: loading: 'lazy', alt: gift_product.title, class: 'sbx__gift-img' }}
                {%- endif -%}
                <span class="sbx__gift-label">+ FREE {{ gift_product.title }}</span>
                <span class="sbx__gift-value">{{ gift_product.price | money }}</span>
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- assign is_first_tile = false -%}
      {%- endfor -%}
    </div>

    <input type="hidden" data-sbx-id-input name="id" form="{{ product_form_id }}" value="{{ first_pack_variant_id }}">
    <input type="hidden" data-sbx-plan-input name="selling_plan" form="{{ product_form_id }}" value="">
  </div>

  <script src="{{ 'bundle-buybox.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
