        "liquid_AGzJpH": {
          "type": "liquid",
          "settings": {
            "liquid": "{%- comment %} SIRAAT — Looping 2h 43m countdown {% endcomment -%}\n\n{%- assign eyebrow    = '4th of July Sale ends in' -%}\n{%- assign subtitle   = 'Free mystery gift with every order 🎁' -%}\n{%- assign accent     = '#AC1A1A' -%}\n{%- assign show_pulse = true -%}\n\n<style>\n  .siraat-pts { --st-accent: {{ accent }}; --st-muted: #6B6B6B; }\n  .siraat-pts * { box-sizing: border-box; }\n  .siraat-pts .st-banner {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    display: flex;\n    flex-direction: column;\n    background: #FAF6F1;\n    border: 1px solid #E8C4C4;\n    border-radius: 8px;\n    overflow: hidden;\n  }\n  .siraat-pts .st-bar { width: 100%; height: 4px; background: var(--st-accent); }\n  .siraat-pts .st-content { padding: 11px 14px 12px; display: flex; flex-direction: column; gap: 8px; }\n  .siraat-pts .st-top { display: flex; align-items: center; gap: 9px; }\n  .siraat-pts .st-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--st-accent); flex-shrink: 0; }\n\n  {%- if show_pulse %}\n  .siraat-pts .st-dot { animation: siraat-pts-pulse 1.6s ease-in-out infinite; }\n  {%- endif %}\n\n  @keyframes siraat-pts-pulse {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: .35; transform: scale(.8); }\n  }\n\n  .siraat-pts .st-eyebrow {\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: .05em;\n    text-transform: uppercase;\n    color: var(--st-accent);\n    margin: 0;\n    line-height: 1.3;\n  }\n\n  .siraat-pts .st-eyebrow small {\n    display: block;\n    font-size: 10px;\n    font-weight: 500;\n    letter-spacing: 0;\n    text-transform: none;\n    color: var(--st-muted);\n    margin-top: 2px;\n  }\n\n  .siraat-pts .st-timer { display: flex; gap: 6px; }\n\n  .siraat-pts .st-seg {\n    flex: 1;\n    background: var(--st-accent);\n    color: #fff;\n    border-radius: 6px;\n    padding: 5px 3px 4px;\n    text-align: center;\n    font-variant-numeric: tabular-nums;\n    font-feature-settings: \"tnum\";\n  }\n\n  .siraat-pts .st-seg b {\n    display: block;\n    font-size: 16px;\n    font-weight: 800;\n    line-height: 1;\n  }\n\n  .siraat-pts .st-seg i {\n    display: block;\n    font-size: 8px;\n    font-style: normal;\n    letter-spacing: .05em;\n    text-transform: uppercase;\n    opacity: .8;\n    margin-top: 3px;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .siraat-pts .st-dot { animation: none; }\n  }\n</style>\n\n<div class=\"siraat-pts\">\n  <div class=\"st-banner\" data-siraat-timer role=\"timer\" aria-label=\"{{ eyebrow | escape }}\">\n    <div class=\"st-bar\"></div>\n\n    <div class=\"st-content\">\n      <div class=\"st-top\">\n        <span class=\"st-dot\"></span>\n        <p class=\"st-eyebrow\">\n          {{ eyebrow }}\n          {%- if subtitle != blank -%}\n            <small>{{ subtitle }}</small>\n          {%- endif -%}\n        </p>\n      </div>\n\n      <div class=\"st-timer\">\n        <span class=\"st-seg\"><b data-unit=\"hours\">02</b><i>hrs</i></span>\n        <span class=\"st-seg\"><b data-unit=\"mins\">43</b><i>min</i></span>\n        <span class=\"st-seg\"><b data-unit=\"secs\">00</b><i>sec</i></span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  var timers = document.querySelectorAll('.siraat-pts [data-siraat-timer]');\n  if (!timers.length) return;\n\n  function pad(n) {\n    return String(n).padStart(2, '0');\n  }\n\n  timers.forEach(function (el) {\n    if (el.dataset.stInit === '1') return;\n    el.dataset.stInit = '1';\n\n    var duration = (2 * 60 * 60 * 1000) + (43 * 60 * 1000);\n    var end = Date.now() + duration;\n\n    function setUnit(unit, val) {\n      var node = el.querySelector('[data-unit=\"' + unit + '\"]');\n      if (node) node.textContent = pad(val);\n    }\n\n    function resetTimer() {\n      end = Date.now() + duration;\n    }\n\n    function tick() {\n      var diff = end - Date.now();\n\n      if (diff <= 0) {\n        resetTimer();\n        diff = end - Date.now();\n      }\n\n      var hours = Math.floor(diff / 3600000);\n      diff -= hours * 3600000;\n\n      var mins = Math.floor(diff / 60000);\n      diff -= mins * 60000;\n\n      var secs = Math.floor(diff / 1000);\n\n      setUnit('hours', hours);\n      setUnit('mins', mins);\n      setUnit('secs', secs);\n    }\n\n    tick();\n    setInterval(tick, 1000);\n  });\n})();\n</script>"
          }
