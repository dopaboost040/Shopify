r tag just above it\n  \n  6. To customize the message, you can pass variables:\n     {% render 'gift-banner-block', \n        headline: 'Special Offer!',\n        message: 'Limited time discount available',\n        ribbon_image: 'YOUR_IMAGE_URL_HERE'\n     %}\n{% endcomment %}\n\n{% comment %}\n  Version with customizable parameters:\n{% endcomment %}\n\n{% if headline or message %}\n  <div class=\"gift-banner-container\">\n    <div class=\"gift-ribbon-vertical\">\n      <img \n        src=\"{{ ribbon_image | default: 'https://cdn.shopify.com/s/files/1/0930/4218/0471/files/Untitled_design_65.png?v=1762089154' }}\" \n        alt=\"Gift Ribbon\" \n        class=\"ribbon-image\"\n        loading=\"lazy\"\n      />\n    </div>\n    \n    <div class=\"gift-banner-text\">\n      {% if headline %}<span class=\"highlight\">{{ headline }}</span><br>{% endif %}\n      {% if message %}{{ message }}{% endif %}\n    </div>\n  </div>\n{% endif %}"
