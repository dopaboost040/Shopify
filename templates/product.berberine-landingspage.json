            "liquid": "{% comment %} Product Rating Display With URL-Bound Random Number {% endcomment %}\n<div class=\"product-ratings\" id=\"scroll-to-reviews\">\n  <div class=\"star-rating\" id=\"goToReviews\">\n    {% for i in (1..4) %}\n      <span class=\"star filled\">★</span>\n    {% endfor %}\n    <span class=\"star half\">★</span>\n  </div>\n  \n  <p class=\"rating-text\">\n    <strong id=\"dynamicMonthlyCount\"></strong>\n  </p>\n</div>\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Gilda+Display:ital@1&display=swap');\n\n  .product-ratings {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin: 10px 0;\n    font-family: 'Gilda Display', serif;\n    font-style: italic;\n    cursor: pointer;\n  }\n  \n  .star-rating {\n    display: flex;\n    gap: 1px;\n  }\n  \n  .star {\n    font-size: 16px;\n    line-height: 1;\n  }\n  \n  .star.filled {\n    color: #C1633F;\n  }\n  \n  .star.half {\n    color: #C1633F;\n    opacity: 0.6;\n  }\n  \n  .rating-text {\n    font-size: 14px;\n    margin: 0;\n    color: #333;\n    line-height: 1;\n    font-weight: 400;\n    font-family: 'Gilda Display', serif;\n    font-style: italic;\n  }\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n\n  /* ------------ FIXED-PER-URL RANDOM NUMBER ------------ */\n  const min = 17000;\n  const max = 35000;\n\n  // Gebruik de URL als 'seed'\n  const url = window.location.pathname;\n\n  // Simpele hash functie om consistent getal te genereren per URL\n  function hashString(str) {\n    let hash = 0;\n    for (let i = 0; i < str.length; i++) {\n      hash = str.charCodeAt(i) + ((hash << 5) - hash);\n    }\n    return Math.abs(hash);\n  }\n\n  // Basisgetal in de range\n  let base = Math.floor((hashString(url) % (max - min + 1)) + min);\n\n  // Geen afgeronde getallen zoals ...00 of ...05 (laatste digit 0 of 5)\n  let lastDigit = base % 10;\n  if (lastDigit === 0 || lastDigit === 5) {\n    if (base + 1 <= max) {\n      base = base + 1;\n    } else {\n      base = base - 1;\n    }\n  }\n\n  const seededNumber = base;\n\n  // Plaats tekst\n  const textElement = document.getElementById(\"dynamicMonthlyCount\");\n  if (textElement) {\n    textElement.textContent = seededNumber.toLocaleString() + \"+ feel the benefits monthly\";\n  }\n\n  /* ------------ SCROLL TO REVIEWS ------------ */\n  const trigger = document.querySelector('.product-ratings');\n  const reviewsSection = document.querySelector('#shopify-block-AUURVMUlseVpmVUNIR__okendo_reviews_widget_kW3zJT');\n\n  if (trigger && reviewsSection) {\n    trigger.addEventListener('click', function() {\n      reviewsSection.scrollIntoView({\n        behavior: 'smooth',\n        block: 'start'\n      });\n    });\n  }\n});\n</script>"
