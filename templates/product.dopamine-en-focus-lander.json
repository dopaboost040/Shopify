    "faq_KkFmHe": {
      "type": "faq",
      "blocks": {
        "faq_item_bh8Fha": {
          "type": "faq_item",
          "settings": {
            "question": "Do we ship worldwide?",
            "answer": "<p>Yes!  We offer free worldwide shipping on all orders.<br/><br/>Your patches are packed and shipped within 24 hours, and delivery usually takes 5–6  days depending on your location.</p>"
          }
        },
        "faq_item_Mibjki": {
          "type": "faq_item",
          "settings": {
            "question": "Can I buy once or do I need a subscription?",
            "answer": "<p>You can choose what works best for you. 💛<br/><br/>Order once to try it out, or subscribe to get your patches delivered automatically every month with an exclusive discount.</p>"
          }
        },
        "faq_item_JzViGm": {
          "type": "faq_item",
          "settings": {
            "question": "How long should I wear one patch?",
            "answer": "<p>Each patch is designed to last up to 8 hours for optimal nutrient release.<br/><br/>Apply it to clean, dry skin and simply remove it at the end of the day.</p>"
          }
        },
        "faq_item_UMEgXb": {
          "type": "faq_item",
          "settings": {
            "question": "Can I sleep with the patch on?",
            "answer": "<p>Yes 😴, our patches are safe, breathable, and gentle on the skin.<br/><br/>You can comfortably wear them overnight if you prefer extended use</p>"
          }
        },
        "faq_item_BKGdDH": {
          "type": "faq_item",
          "settings": {
            "question": "Where should I apply the patch?",
            "answer": "<p>For best results, place the patch on a clean, hair-free area like your upper arm, shoulder, or back.<br/><br/>Rotate placement daily to keep your skin happy and fresh.</p>"
          }
        },
        "faq_item_Wfwg3P": {
          "type": "faq_item",
          "settings": {
            "question": "Are the patches waterproof?",
            "answer": "<p>Yes! Our patches are water-resistant, so you can shower or work out without worry.<br/><br/>Just avoid rubbing the area too hard to keep it firmly in place.</p>"
          }
        }
      },
