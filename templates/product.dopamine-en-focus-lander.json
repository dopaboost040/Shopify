r: #C1633F;\n    font-weight: 700;\n  }\n  \n  .product-info-section .delivery-info {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    color: #333333;\n    font-size: 14px;\n    padding-top: 12px;\n    border-top: 1px solid #eeeeee;\n    font-weight: 500;\n  }\n  \n  .product-info-section .delivery-icon {\n    width: 20px;\n    height: 20px;\n    flex-shrink: 0;\n    color: #666666;\n  }\n</style>\n\n<div class=\"product-info-section\">\n  <div class=\"almost-sold-out\">\n    <div class=\"pulse-dot\"></div>\n    <span>Limited Stock Remaining</span>\n  </div>\n  \n  <div class=\"product-stats\">\n    This product was bought <strong>{{ final_number }}</strong> times this week\n  </div>\n  \n  <div class=\"delivery-info\">\n    <svg class=\"delivery-icon\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\" stroke-width=\"2\"></circle>\n      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6v6l4 2\"></path>\n    </svg>\n    <span>\n      Order today, receive \n      {{ \"now\" | date: \"%s\" | plus: 259200 | date: \"%A, %B %d\" }}\n    </span>\n  </div>\n</div>\n\n{% comment %}\n  HEARTBEAT ANIMATION ACTIVE\n{% endcomment %}"
