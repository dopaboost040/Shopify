: 'Gilda Display', serif;\n  font-style: italic;\n  cursor: pointer;\n}\n.customer-photos {\n  display: flex;\n  align-items: center;\n}\n.customer-photo {\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  object-fit: cover;\n  border: 1.5px solid #fff;\n  box-shadow: 0 0 0 1px #E4E0DA;\n}\n.customer-photo:not(:first-child) {\n  margin-left: -6px;\n}\n.star-rating {\n  display: flex;\n  align-items: center;\n  gap: 1px;\n  line-height: 1;\n}\n.star-icon {\n  width: 16px;\n  height: 16px;\n  display: block;\n}\n.star-icon.filled path {\n  fill: #C1633F;\n}\n.diagonal-half .star-bg {\n  fill: #E4E0DA;\n}\n.diagonal-half .star-fg {\n  fill: #C1633F;\n}\n.rating-text {\n  font-size: 14px;\n  margin: 0;\n  color: #333;\n  line-height: 1;\n  font-weight: 400;\n  font-family: 'Gilda Display', serif;\n  font-style: italic;\n}\n/* Mobiel: foto's boven de sterren */\n@media (max-width: 599px) {\n  .product-ratings {\n    flex-wrap: wrap;\n    row-gap: 4px;\n  }\n  .customer-photos {\n    flex-basis: 100%;\n    order: -1;\n  }\n}\n</style>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  const min = 17000;\n  const max = 35000;\n  const url = window.location.pathname;\n  function hashString(str) {\n    let hash = 0;\n    for (let i = 0; i < str.length; i++) {\n      hash = str.charCodeAt(i) + ((hash << 5) - hash);\n    }\n    return Math.abs(hash);\n  }\n  let base = Math.floor((hashString(url) % (max - min + 1)) + min);\n  let lastDigit = base % 10;\n  if (lastDigit === 0 || lastDigit === 5) {\n    if (base + 1 <= max) {\n      base = base + 1;\n    } else {\n      base = base - 1;\n    }\n  }\n  const seededNumber = base;\n  const textElement = document.getElementById(\"dynamicMonthlyCount\");\n  if (textElement) {\n    textElement.textContent = seededNumber.toLocaleString() + \"+ feel the benefits monthly\";\n  }\n  const trigger = document.querySelector('.product-ratings');\n  const reviewsSection = document.querySelector('#shopify-block-AUURVMUlseVpmVUNIR__okendo_reviews_widget_kW3zJT');\n  if (trigger && reviewsSection) {\n    trigger.addEventListener('click', function() {\n      reviewsSection.scrollIntoView({\n        behavior: 'smooth',\n        block: 'start'\n      });\n    });\n  }\n});\n</script>"
